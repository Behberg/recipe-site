---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import RecipeArt from '../../../components/RecipeArt.astro';
import RecipeCard from '../../../components/RecipeCard.astro';
import FavButton from '../../../components/FavButton.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { SITE } from '../../../site.config';
import {
  getCatalog,
  getRecipes,
  formatMinutes,
  formatAmount,
  totalTime,
  cuisineUrl,
  categoryUrl,
  imageUrl,
} from '../../../lib/recipes';
import { unitFor } from '../../../lib/format';
import { IMAGE_RATIOS, recipeImagePath } from '../../../lib/recipeImage';
import { absolute, breadcrumbLd, dietsFor } from '../../../lib/seo';
import { LANGS, langParam, href, t, count, type Lang, type UIKey } from '../../../i18n';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  return LANGS.flatMap((lang) => recipes.map((r) => ({ params: { lang: langParam(lang), slug: r.id }, props: { lang } })));
}

const { lang } = Astro.props as { lang: Lang };
const u = (p: string) => href(lang, p);
const { recipes, cuisineById, categoryById } = await getCatalog(lang);
const recipe = recipes.find((r) => r.id === Astro.params.slug)!;
const d = recipe.data;
const cuisine = cuisineById.get(d.cuisine.id);
const category = categoryById.get(d.category.id);
const { Content } = await render(recipe.story);
const hasStory = recipe.story.body?.trim().length;

const emoji = d.emoji || category?.data.emoji || '🍽️';
const color = category?.data.color || cuisine?.data.color || '#9e3039';
const total = totalTime(recipe);

// Group ingredients by their optional "group" field, keeping the original order.
const groups: { name?: string; items: typeof d.ingredients }[] = [];
for (const ing of d.ingredients) {
  const last = groups[groups.length - 1];
  if (last && last.name === ing.group) last.items.push(ing);
  else groups.push({ name: ing.group, items: [ing] });
}

/** Finds "10 minūtes", "3 līdz 4 minūtes" or "1,5 stundas" in a step and returns seconds. */
function detectTimer(text: string): number | null {
  const m = text.match(/(\d+(?:[.,]\d+)?)(?:\s*(?:līdz|-)\s*(\d+(?:[.,]\d+)?))?\s*(minūt|min\b|stund)/i);
  if (!m) return null;
  const value = parseFloat((m[2] || m[1]).replace(',', '.'));
  const secs = Math.round(value * (m[3].toLowerCase().startsWith('stund') ? 3600 : 60));
  return secs > 0 && secs <= 6 * 3600 ? secs : null;
}
let ingIndex = 0;
// Timers are read from the Latvian steps, so every translation gets the same timers.
const steps = d.steps.map((text, i) => ({ text, timer: detectTimer(recipe.lv.steps[i] ?? text) }));
const minutes = (secs: number) => formatMinutes(Math.round(secs / 60), lang);

// Name first, amount after: "Kviešu milti: 500 g". With the amount first Latvian (and Russian,
// Lithuanian) would need the genitive ("500 g kviešu miltu"), so names stay in their normal form.
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const unitText = (unit: string | undefined, amount?: number) => (unit ? unitFor(unit, amount ?? 1, lang) : '');
const amountText = (i: (typeof d.ingredients)[number]) =>
  [i.amount ? formatAmount(i.amount, lang) : '', unitText(i.unit, i.amount)].filter(Boolean).join(' ');
const ingredientText = (i: (typeof d.ingredients)[number]) => (amountText(i) ? `${cap(i.name)}: ${amountText(i)}` : cap(i.name));

// Related: same category first, then same cuisine.
const related = recipes
  .filter((r) => r.id !== recipe.id)
  .map((r) => ({
    r,
    score: (r.data.category.id === d.category.id ? 2 : 0) + (r.data.cuisine.id === d.cuisine.id ? 1 : 0) + (r.data.tags.some((t) => d.tags.includes(t)) ? 1 : 0),
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 8)
  .map((x) => x.r);

const iso = (min: number) => `PT${min}M`;
const pageUrl = absolute(u(`/recepte/${recipe.id}/`), Astro.site);
// Google needs an image for recipe rich results. An uploaded photo wins; otherwise the
// generated illustration in the three aspect ratios Google recommends.
const images = d.image
  ? [new URL(imageUrl(d.image, 1200), Astro.site).href]
  : (Object.keys(IMAGE_RATIOS) as (keyof typeof IMAGE_RATIOS)[]).map((r) => absolute(recipeImagePath(recipe.id, r), Astro.site));
const shareImage = d.image ? imageUrl(d.image, 1200) : recipeImagePath(recipe.id, '16x9');
const amountSentence = cap(d.yield ? t(lang, 'recipe.yield', { y: d.yield }) : count(lang, d.servings, 'count.servings'));
const metaDescription = t(lang, 'seo.recipeDesc', { desc: d.description, time: formatMinutes(total, lang), amount: amountSentence }).replace(/\.\.$/, '.');
const diets = dietsFor(recipe.lv.tags);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Recipe',
    '@id': `${pageUrl}#recipe`,
    mainEntityOfPage: pageUrl,
    url: pageUrl,
    name: d.title,
    description: d.description,
    image: images,
    author: { '@type': 'Organization', name: SITE.name, url: absolute('/', Astro.site) },
    publisher: { '@id': absolute('/#organization', Astro.site) },
    datePublished: d.date.toISOString().slice(0, 10),
    inLanguage: lang,
    prepTime: iso(d.prepTime),
    cookTime: iso(d.cookTime),
    totalTime: iso(total),
    recipeYield: d.yield ? d.yield : [String(d.servings), count(lang, d.servings, 'count.servings')],
    recipeCategory: category?.data.name,
    recipeCuisine: cuisine?.data.name,
    keywords: [d.title, cuisine && t(lang, 'cuisine.title', { name: cuisine.data.name }), category?.data.name, ...d.tags].filter(Boolean).join(', '),
    suitableForDiet: diets.length ? diets : undefined,
    recipeIngredient: d.ingredients.map(ingredientText),
    recipeInstructions: d.steps.map((text, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: t(lang, 'recipe.stepLabel', { n: i + 1 }),
      text,
      url: `${pageUrl}#solis-${i + 1}`,
    })),
  },
  breadcrumbLd(
    [
      { name: SITE.name, path: u('/') },
      ...(category ? [{ name: category.data.name, path: categoryUrl(category.id, lang) }] : []),
      { name: d.title, path: u(`/recepte/${recipe.id}/`) },
    ],
    Astro.site,
  ),
];

const useMultiplier = Boolean(d.yield);
---

<Base
  title={t(lang, 'seo.recipeTitle', { title: d.title })}
  description={metaDescription}
  image={shareImage}
  imageSize={d.image ? undefined : [...IMAGE_RATIOS['16x9']]}
  imageAlt={d.title}
  published={d.date.toISOString().slice(0, 10)}
  type="article"
  jsonLd={jsonLd}
>
  <article class="recipe" data-recipe-page data-servings={d.servings}>
    <!-- Hero -->
    <header class="r-hero container">
      <div class="r-media">
        <RecipeArt image={d.image} emoji={emoji} icon={d.icon} iconColors={d.iconColors} iconExtra={d.iconExtra} color={color} alt={d.title} sizes="(min-width: 900px) 560px, 100vw" large eager />
        <div class="r-media-actions no-print">
          <a class="fav-btn" href={categoryUrl(d.category.id, lang)} aria-label={t(lang, 'recipe.backTo', { name: category?.data.name ?? '' })}>
            <Icon name="chevron-left" />
          </a>
          <FavButton id={recipe.id} title={d.title} lang={lang} />
        </div>
      </div>

      <div class="r-head">
        <nav class="r-tags" aria-label={t(lang, 'recipe.tagsNav')}>
          {cuisine && <a class="chip" href={cuisineUrl(cuisine.id, lang)}><span aria-hidden="true">{cuisine.data.emoji}</span>{cuisine.data.name}</a>}
          {category && <a class="chip" href={categoryUrl(category.id, lang)}><span aria-hidden="true">{category.data.emoji}</span>{category.data.name}</a>}
        </nav>
        <h1>{d.title}</h1>
        <p class="r-desc">{d.description}</p>
        {!recipe.translated && <p class="r-untranslated">{t(lang, 'recipe.untranslated')}</p>}

        <dl class="r-stats">
          <div><dt>{t(lang, 'recipe.prep')}</dt><dd>{formatMinutes(d.prepTime, lang)}</dd></div>
          <div><dt>{t(lang, 'recipe.cook')}</dt><dd>{formatMinutes(d.cookTime, lang)}</dd></div>
          <div><dt>{t(lang, 'recipe.total')}</dt><dd>{formatMinutes(total, lang)}</dd></div>
          <div><dt>{t(lang, 'recipe.difficulty')}</dt><dd>{t(lang, `diff.${d.difficulty}` as UIKey)}</dd></div>
        </dl>

        <div class="r-actions no-print" data-hero-actions>
          <button type="button" class="btn btn-primary" data-cook-open>
            <Icon name="play" /> {t(lang, 'recipe.start')}
          </button>
          <button type="button" class="icon-btn outline" data-share aria-label={t(lang, 'recipe.share')}>
            <Icon name="share" />
          </button>
          <button type="button" class="icon-btn outline" data-print aria-label={t(lang, 'recipe.print')}>
            <Icon name="printer" />
          </button>
        </div>
      </div>
    </header>

    {
      hasStory && (
        <section class="container r-story">
          <Content />
        </section>
      )
    }

    <div class="container"><AdSlot slot="recipeTop" /></div>

    <div class="container r-body">
      <!-- Ingredients -->
      <section class="r-ingredients" aria-labelledby="ing-title">
        <div class="panel">
          <div class="panel-head">
            <h2 id="ing-title">{t(lang, 'recipe.ingredients')}</h2>
            {
              useMultiplier ? (
                <div class="seg no-print" role="group" aria-label={t(lang, 'recipe.amount')} data-multiplier>
                  {[0.5, 1, 2, 3].map((m) => (
                    <button type="button" data-factor={m} aria-pressed={m === 1 ? 'true' : 'false'}>
                      {m === 0.5 ? '½' : m}×
                    </button>
                  ))}
                </div>
              ) : (
                <div class="stepper no-print" data-stepper>
                  <button type="button" class="icon-btn" data-step="-1" aria-label={t(lang, 'recipe.fewer')}><Icon name="minus" /></button>
                  <span><strong data-servings-out>{d.servings}</strong> {t(lang, 'recipe.servingsShort')}</span>
                  <button type="button" class="icon-btn" data-step="1" aria-label={t(lang, 'recipe.more')}><Icon name="plus" /></button>
                </div>
              )
            }
          </div>
          {d.yield && <p class="yield"><Icon name="users" /> {t(lang, 'recipe.yield', { y: d.yield })}<span data-yield-factor></span></p>}

          <p class="adjust-hint no-print" data-adjust-hint>
            <Icon name="scale" />
            <span>{t(lang, 'recipe.adjustHint')}</span>
          </p>
          <div class="adjusted no-print" data-adjusted hidden>
            <span>{t(lang, 'recipe.adjusted')} <strong data-factor-out>×1</strong></span>
            <button type="button" class="reset-factor" data-factor-reset><Icon name="refresh" /> {t(lang, 'recipe.reset')}</button>
          </div>

          {
            groups.map((g) => (
              <div class="ing-group">
                {g.name && <h3>{g.name}</h3>}
                <ul>
                  {g.items.map((i) => {
                    const id = `ing-${ingIndex++}`;
                    return (
                      <li class="ing">
                        <input type="checkbox" id={id} />
                        <label for={id} class="tick" aria-hidden="true">
                          <Icon name="check" />
                        </label>
                        <span class="ing-text">
                          <label for={id} class="ing-name">{cap(i.name)}</label>
                          {i.amount ? (
                            <button
                              type="button"
                              class="qty qty-btn"
                              data-amount={i.amount}
                              data-unit={i.unit ?? ''}
                              data-name={cap(i.name)}
                              aria-label={t(lang, 'recipe.qtyAria', { name: cap(i.name), amount: amountText(i) })}
                            >
                              {amountText(i)}
                            </button>
                          ) : (
                            i.unit && <b class="qty">{unitText(i.unit)}</b>
                          )}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Steps -->
      <section class="r-steps" aria-labelledby="steps-title">
        <h2 id="steps-title">{t(lang, 'recipe.steps')}</h2>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="step" id={`solis-${i + 1}`} data-step-index={i}>
                <button type="button" class="step-num" aria-label={t(lang, 'recipe.markStep', { n: i + 1 })}>
                  <span class="n">{i + 1}</span>
                  <Icon name="check" class="c" />
                </button>
                <div class="step-body">
                  <p>{s.text}</p>
                  {s.timer && (
                    <button type="button" class="timer-chip no-print" data-timer={s.timer} data-timer-label={t(lang, 'recipe.stepLabel', { n: i + 1 })} data-timer-recipe={d.title}>
                      <Icon name="timer" /> <span data-timer-text>{t(lang, 'recipe.timer', { time: minutes(s.timer) })}</span>
                    </button>
                  )}
                </div>
              </li>
            ))
          }
        </ol>

        {
          d.tips.length > 0 && (
            <aside class="tips">
              <h3><Icon name="bulb" /> {t(lang, 'recipe.tips')}</h3>
              <ul>
                {d.tips.map((t) => <li>{t}</li>)}
              </ul>
            </aside>
          )
        }

        {
          d.tags.length > 0 && (
            <div class="r-tagcloud">
              {d.tags.map((tag) => <a class="chip" href={u(`/receptes/?q=${encodeURIComponent(tag)}`)}>#{tag}</a>)}
            </div>
          )
        }
      </section>
    </div>

    <div class="container"><AdSlot slot="recipeBottom" /></div>

    {
      related.length > 0 && (
        <section class="section container no-print">
          <div class="section-head">
            <div>
              <span class="eyebrow">{t(lang, 'recipe.relatedEyebrow')}</span>
              <h2>{t(lang, 'recipe.relatedTitle')}</h2>
            </div>
          </div>
          <div class="rail">
            {related.map((r) => (
              <RecipeCard recipe={r} cuisine={cuisineById.get(r.data.cuisine.id)} category={categoryById.get(r.data.category.id)} wide />
            ))}
          </div>
        </section>
      )
    }

    <!-- Floating CTA (mobile) -->
    <button type="button" class="float-cta btn btn-primary no-print" data-cook-open data-float-cta>
      <Icon name="play" /> {t(lang, 'recipe.start')}
    </button>

    <!-- Cooking mode -->
    <dialog class="cook" data-cook aria-label={t(lang, 'cook.aria', { title: d.title })}>
      <div class="cook-inner">
        <header class="cook-top">
          <button type="button" class="icon-btn" data-cook-close aria-label={t(lang, 'cook.close')}><Icon name="x" /></button>
          <div class="cook-title">
            <span data-cook-count>1 / {steps.length}</span>
            <strong>{d.title}</strong>
          </div>
          <button type="button" class="icon-btn" data-cook-ing aria-label={t(lang, 'cook.showIngredients')}><Icon name="list" /></button>
        </header>
        <div class="cook-progress"><span data-cook-bar></span></div>

        <div class="cook-stage" data-cook-stage>
          {
            steps.map((s, i) => (
              <section class="cook-step" data-cook-step={i} hidden={i !== 0}>
                <span class="cook-step-n">{t(lang, 'cook.step', { n: i + 1 })}</span>
                <p>{s.text}</p>
                {s.timer && (
                  <button type="button" class="btn btn-ghost cook-timer" data-timer={s.timer} data-timer-label={t(lang, 'recipe.stepLabel', { n: i + 1 })} data-timer-recipe={d.title}>
                    <Icon name="timer" /> <span data-timer-text>{t(lang, 'recipe.startTimer', { time: minutes(s.timer) })}</span>
                  </button>
                )}
              </section>
            ))
          }
          <section class="cook-step cook-done" data-cook-step={steps.length} hidden>
            <span class="big" aria-hidden="true">🎉</span>
            <h2>{t(lang, 'cook.doneTitle')}</h2>
            <p>{t(lang, 'cook.doneText')}</p>
            <div class="cook-done-actions">
              <FavButton id={recipe.id} title={d.title} class="cook-fav" lang={lang} />
              <button type="button" class="btn btn-primary" data-cook-close>{t(lang, 'cook.finish')}</button>
            </div>
          </section>
        </div>

        <aside class="cook-ing" data-cook-ing-panel hidden>
          <h3>{t(lang, 'recipe.ingredients')}</h3>
          <ul>
            {d.ingredients.map((i) => (
              <li>
                <span>{cap(i.name)}</span>
                {i.amount ? (
                  <b class="qty" data-amount={i.amount} data-unit={i.unit ?? ''}>
                    {amountText(i)}
                  </b>
                ) : (
                  i.unit && <b>{unitText(i.unit)}</b>
                )}
              </li>
            ))}
          </ul>
        </aside>

        <footer class="cook-nav">
          <button type="button" class="btn btn-ghost" data-cook-prev><Icon name="chevron-left" /> {t(lang, 'cook.back')}</button>
          <button type="button" class="btn btn-primary" data-cook-next>{t(lang, 'cook.next')} <Icon name="chevron-right" /></button>
        </footer>
      </div>
    </dialog>

    <!-- "Cik tev ir?" sheet -->
    <dialog class="sheet amount-sheet" data-amount-sheet aria-labelledby="amount-title">
      <div class="sheet-grip" aria-hidden="true"></div>
      <h2 id="amount-title">{t(lang, 'amount.title')}</h2>
      <p class="amount-name" data-amount-name></p>
      <form method="dialog" class="amount-form" data-amount-form>
        <div class="amount-row">
          <input type="number" inputmode="decimal" step="any" min="0" required data-amount-input aria-label={t(lang, 'recipe.amount')} />
          <select data-amount-unit aria-label={t(lang, 'amount.unit')}></select>
          <span class="amount-unit-fixed" data-amount-unit-fixed></span>
        </div>
        <p class="amount-preview" data-amount-preview></p>
        <div class="amount-actions">
          <button type="button" class="btn btn-ghost" data-amount-cancel>{t(lang, 'common.cancel')}</button>
          <button type="submit" class="btn btn-primary" value="ok">{t(lang, 'amount.apply')}</button>
        </div>
      </form>
      <button type="button" class="icon-btn sheet-close" data-amount-cancel aria-label={t(lang, 'common.close')}><Icon name="x" /></button>
    </dialog>
  </article>
</Base>

<script>
  import { formatAmount, unitFor, decimal } from '../../../lib/format';
  import { toast } from '../../../lib/favorites';
  import { ct, pageLang } from '../../../i18n/client';

  const lang = pageLang();

  const page = document.querySelector<HTMLElement>('[data-recipe-page]')!;
  const baseServings = Number(page.dataset.servings) || 1;

  /* ---------- Scaling: servings, ½× to 3×, or "man ir 650 g zemeņu" ---------- */
  const qtys = Array.from(page.querySelectorAll<HTMLElement>('.qty[data-amount]'));
  // When scaling, 1500 g reads better as 1,5 kg and 0,3 kg better as 300 g.
  const BIGGER: Record<string, [string, number]> = { g: ['kg', 1000], ml: ['l', 1000] };
  const SMALLER: Record<string, [string, number]> = { kg: ['g', 1000], l: ['ml', 1000] };
  const toBase: Record<string, number> = { g: 1, kg: 1000, ml: 1, l: 1000 };
  const pretty = (n: number) => decimal(n, lang);

  let factor = 1;
  const stepper = page.querySelector<HTMLElement>('[data-stepper]');
  const servingsOut = stepper?.querySelector<HTMLElement>('[data-servings-out]');
  const mult = page.querySelector<HTMLElement>('[data-multiplier]');
  const adjusted = page.querySelector<HTMLElement>('[data-adjusted]')!;
  const hint = page.querySelector<HTMLElement>('[data-adjust-hint]');
  const factorOut = page.querySelector<HTMLElement>('[data-factor-out]')!;
  const yieldFactor = page.querySelector<HTMLElement>('[data-yield-factor]');

  function setFactor(f: number, fromCustom = false) {
    factor = Math.max(0.05, Math.min(50, f));
    qtys.forEach((q) => {
      let amount = Number(q.dataset.amount) * factor;
      let unit = q.dataset.unit ?? '';
      const up = BIGGER[unit];
      const down = SMALLER[unit];
      if (up && amount >= up[1]) {
        amount /= up[1];
        unit = up[0];
      } else if (down && amount < 1) {
        amount *= down[1];
        unit = down[0];
      }
      const unitLabel = unit ? unitFor(unit, amount, lang) : '';
      q.textContent = formatAmount(amount, lang) + (unitLabel ? ' ' + unitLabel : '');
    });
    if (servingsOut) servingsOut.textContent = pretty(baseServings * factor);
    mult?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(!fromCustom && Number(b.dataset.factor) === factor)));
    const isOne = Math.abs(factor - 1) < 0.001;
    adjusted.hidden = !fromCustom || isOne;
    if (hint) hint.hidden = fromCustom && !isOne;
    factorOut.textContent = `×${pretty(factor)}`;
    if (yieldFactor) yieldFactor.textContent = isOne ? '' : ` (×${pretty(factor)})`;
  }

  stepper?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-step]');
    if (!btn) return;
    const current = Math.round(baseServings * factor);
    const next = Math.min(50, Math.max(1, current + Number(btn.dataset.step)));
    setFactor(next / baseServings);
  });
  mult?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-factor]');
    if (btn) setFactor(Number(btn.dataset.factor));
  });
  page.querySelector('[data-factor-reset]')!.addEventListener('click', () => setFactor(1));

  // "Cik tev ir?" sheet
  const sheet = page.querySelector<HTMLDialogElement>('[data-amount-sheet]')!;
  const form = sheet.querySelector<HTMLFormElement>('[data-amount-form]')!;
  const input = sheet.querySelector<HTMLInputElement>('[data-amount-input]')!;
  const unitSelect = sheet.querySelector<HTMLSelectElement>('[data-amount-unit]')!;
  const unitFixed = sheet.querySelector<HTMLElement>('[data-amount-unit-fixed]')!;
  const nameOut = sheet.querySelector<HTMLElement>('[data-amount-name]')!;
  const preview = sheet.querySelector<HTMLElement>('[data-amount-preview]')!;
  let target: HTMLElement | null = null;

  const readBase = () => {
    const v = parseFloat(input.value.replace(',', '.'));
    if (!target || !(v > 0)) return null;
    const unit = target.dataset.unit ?? '';
    const chosen = unitSelect.hidden ? unit : unitSelect.value;
    const entered = toBase[chosen] ? v * toBase[chosen] : v;
    const original = toBase[unit] ? Number(target.dataset.amount) * toBase[unit] : Number(target.dataset.amount);
    return entered / original;
  };
  const updatePreview = () => {
    const f = readBase();
    preview.textContent = f ? ct('amount.preview', { f: pretty(f) }) : ct('amount.enter');
  };

  page.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.qty-btn');
    if (!btn) return;
    target = btn;
    const unit = btn.dataset.unit ?? '';
    nameOut.textContent = btn.dataset.name ?? '';
    const family = unit === 'g' || unit === 'kg' ? ['g', 'kg'] : unit === 'ml' || unit === 'l' ? ['ml', 'l'] : null;
    unitSelect.hidden = !family;
    unitFixed.hidden = !!family;
    unitFixed.textContent = unitFor(unit, Number(btn.dataset.amount) * factor, lang);
    if (family) {
      unitSelect.replaceChildren(...family.map((u) => new Option(unitFor(u, 2, lang), u)));
      unitSelect.value = unit;
    }
    const current = Number(btn.dataset.amount) * factor;
    input.value = String(Math.round(current * 100) / 100);
    updatePreview();
    sheet.showModal();
    input.select();
  });
  input.addEventListener('input', updatePreview);
  unitSelect.addEventListener('change', updatePreview);
  sheet.querySelectorAll('[data-amount-cancel]').forEach((b) => b.addEventListener('click', () => sheet.close()));
  sheet.addEventListener('click', (e) => e.target === sheet && sheet.close());
  form.addEventListener('submit', (e) => {
    const f = readBase();
    if (!f) {
      e.preventDefault();
      input.focus();
      return;
    }
    setFactor(f, true);
    toast(ct('amount.toast', { f: pretty(f) }));
  });

  /* ---------- Step progress (tap the number to mark as done) ---------- */
  page.querySelectorAll<HTMLElement>('.step').forEach((step) => {
    step.querySelector('.step-num')!.addEventListener('click', () => step.classList.toggle('is-done'));
  });

  /* ---------- Share & print ---------- */
  page.querySelector('[data-share]')?.addEventListener('click', async () => {
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(location.href);
        toast(ct('share.copied'));
      }
    } catch {
      /* user cancelled the share sheet */
    }
  });
  page.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  /* ---------- Floating CTA appears once the hero button is off screen ---------- */
  const heroActions = page.querySelector('[data-hero-actions]');
  const floatCta = page.querySelector<HTMLElement>('[data-float-cta]')!;
  if (heroActions && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => floatCta.classList.toggle('show', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(
      heroActions,
    );
  }

  /* ---------- Cooking mode ---------- */
  const dialog = page.querySelector<HTMLDialogElement>('[data-cook]')!;
  const cookSteps = Array.from(dialog.querySelectorAll<HTMLElement>('[data-cook-step]'));
  const total = cookSteps.length - 1; // last one is the "done" screen
  const bar = dialog.querySelector<HTMLElement>('[data-cook-bar]')!;
  const counter = dialog.querySelector<HTMLElement>('[data-cook-count]')!;
  const prev = dialog.querySelector<HTMLButtonElement>('[data-cook-prev]')!;
  const next = dialog.querySelector<HTMLButtonElement>('[data-cook-next]')!;
  const ingPanel = dialog.querySelector<HTMLElement>('[data-cook-ing-panel]')!;
  let current = 0;
  let wakeLock: any = null;

  function show(i: number, dir = 1) {
    current = Math.max(0, Math.min(total, i));
    cookSteps.forEach((s, idx) => {
      s.hidden = idx !== current;
      if (idx === current) {
        s.style.setProperty('--dir', String(dir));
        s.classList.remove('enter');
        void s.offsetWidth;
        s.classList.add('enter');
      }
    });
    bar.style.width = `${(Math.min(current + 1, total) / total) * 100}%`;
    counter.textContent = current < total ? `${current + 1} / ${total}` : ct('cook.done');
    prev.disabled = current === 0;
    next.hidden = current === total;
    next.innerHTML = current === total - 1 ? ct('cook.finishCheck') : ct('cook.next') + ' <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
  }

  async function lockScreen() {
    try {
      wakeLock = await (navigator as any).wakeLock?.request('screen');
    } catch {
      /* not supported or denied */
    }
  }

  page.querySelectorAll('[data-cook-open]').forEach((b) =>
    b.addEventListener('click', () => {
      dialog.showModal();
      document.dispatchEvent(new CustomEvent('timers:host', { detail: dialog }));
      document.documentElement.classList.add('cook-open');
      show(0);
      lockScreen();
    }),
  );
  // Runs both from our close buttons and from the dialog's own close event (Esc key, back
  // gesture). The event can arrive late, so cleanup must not depend on it alone.
  function onCookClosed() {
    document.dispatchEvent(new CustomEvent('timers:host', { detail: null }));
    document.documentElement.classList.remove('cook-open');
    wakeLock?.release?.();
    wakeLock = null;
    ingPanel.hidden = true;
  }
  function closeCook() {
    dialog.close();
    onCookClosed();
  }
  dialog.addEventListener('close', onCookClosed);
  document.addEventListener('visibilitychange', () => {
    if (dialog.open && document.visibilityState === 'visible') lockScreen();
  });
  dialog.querySelectorAll('[data-cook-close]').forEach((b) => b.addEventListener('click', closeCook));
  prev.addEventListener('click', () => show(current - 1, -1));
  next.addEventListener('click', () => show(current + 1, 1));
  dialog.querySelector('[data-cook-ing]')!.addEventListener('click', () => (ingPanel.hidden = !ingPanel.hidden));
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1, 1);
    if (e.key === 'ArrowLeft') show(current - 1, -1);
  });

  // Swipe left / right between steps.
  let sx = 0;
  let sy = 0;
  const stage = dialog.querySelector<HTMLElement>('[data-cook-stage]')!;
  stage.addEventListener('touchstart', (e) => {
    sx = e.touches[0].clientX;
    sy = e.touches[0].clientY;
  }, { passive: true });
  stage.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx;
    const dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
  }, { passive: true });
</script>

