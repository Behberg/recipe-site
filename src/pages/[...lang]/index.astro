---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import RecipeArt from '../../components/RecipeArt.astro';
import AdSlot from '../../components/AdSlot.astro';
import OccasionBanner from '../../components/OccasionBanner.astro';
import { SITE } from '../../site.config';
import { getCatalog, cuisineUrl, categoryUrl, recipeUrl, formatMinutes, totalTime } from '../../lib/recipes';
import { langFromPath, langPaths, href, t, count } from '../../i18n';
import { trTag } from '../../i18n/data';

export const getStaticPaths = langPaths;

const lang = langFromPath(Astro.url.pathname);
const u = (p: string) => href(lang, p);
const { recipes, cuisines, categories, cuisineById, categoryById } = await getCatalog(lang);
const cozyQuery = u(`/receptes/?q=${encodeURIComponent(trTag(lang, 'mājīgi'))}`);

const featured = recipes.filter((r) => r.data.featured).slice(0, 8);
const latest = recipes.slice(0, 8);
const latvian = recipes.filter((r) => r.data.cuisine.id === 'latviesu').slice(0, 10);
const comfort = recipes.filter((r) => r.lv.tags.includes('mājīgi')).slice(0, 12);
const hero = featured[0] ?? recipes[0];

const countBy = (key: 'cuisine' | 'category', id: string) => recipes.filter((r) => r.data[key].id === id).length;
// Latvian first, then the cuisines with the most recipes.
const topCuisines = [...cuisines].sort((a, b) => Number(b.id === 'latviesu') - Number(a.id === 'latviesu') || countBy('cuisine', b.id) - countBy('cuisine', a.id)).slice(0, 9);
const promo = ['saldie-edieni', 'ievarijumi-un-konservi']
  .map((id) => categoryById.get(id))
  .filter((c) => c !== undefined);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: new URL(u('/'), Astro.site).href,
  inLanguage: lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL(u('/receptes/?q={search_term_string}'), Astro.site).href.replace('%7B', '{').replace('%7D', '}'),
    'query-input': 'required name=search_term_string',
  },
};
---

<Base jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero-copy reveal">
      <span class="eyebrow">{t(lang, 'home.eyebrow')}</span>
      <h1>{t(lang, 'home.title1')} <em>{t(lang, 'home.title2')}</em></h1>
      <p>{t(lang, 'home.lead')}</p>
      <form class="search-field hero-search" action={u('/receptes/')} method="get" role="search">
        <Icon name="search" />
        <input type="search" name="q" placeholder={t(lang, 'home.searchPlaceholder')} aria-label={t(lang, 'nav.search')} enterkeyhint="search" />
      </form>
      <div class="hero-chips">
        <a class="chip" href={u('/receptes/?laiks=30')}>{t(lang, 'home.chipUnder30')}</a>
        <a class="chip" href={cozyQuery}>{t(lang, 'home.chipCozy')}</a>
        <a class="chip" href={cuisineUrl('latviesu', lang)}>{t(lang, 'home.chipLatvian')}</a>
        <a class="chip" href={categoryUrl('saldie-edieni', lang)}>{t(lang, 'home.chipSweets')}</a>
        <a class="chip" href={categoryUrl('ievarijumi-un-konservi', lang)}>{t(lang, 'home.chipJams')}</a>
        <a class="chip" href={categoryUrl('zupas', lang)}>{t(lang, 'home.chipSoups')}</a>
      </div>
      <dl class="hero-stats">
        <div><dt>{t(lang, 'home.statRecipes')}</dt><dd>{recipes.length}</dd></div>
        <div><dt>{t(lang, 'home.statCuisines')}</dt><dd>{cuisines.length}</dd></div>
        <div><dt>{t(lang, 'home.statCategories')}</dt><dd>{categories.length}</dd></div>
      </dl>
    </div>

    {
      hero && (
        <a class="hero-feature reveal" href={recipeUrl(hero.id, lang)} style="animation-delay:.08s">
          <div class="hero-feature-media">
            <RecipeArt
              image={hero.data.image}
              icon={hero.data.icon}
              iconColors={hero.data.iconColors}
              iconExtra={hero.data.iconExtra}
              emoji={hero.data.emoji || categoryById.get(hero.data.category.id)?.data.emoji || '🍽️'}
              color={categoryById.get(hero.data.category.id)?.data.color || '#9e3039'}
              alt={hero.data.title}
              sizes="(min-width: 900px) 520px, 100vw"
              large
              eager
            />
          </div>
          <div class="hero-feature-card">
            <span class="eyebrow">{t(lang, 'home.todaysPick')}</span>
            <h2>{hero.data.title}</h2>
            <span class="hero-feature-meta">
              <Icon name="clock" />
              {formatMinutes(totalTime(hero), lang)}
              <span class="dot">·</span>
              {cuisineById.get(hero.data.cuisine.id)?.data.name}
            </span>
          </div>
        </a>
      )
    }
  </section>

  <!-- Seasonal suggestion from the built-in calendar -->
  <OccasionBanner />

  <!-- Tools -->
  <section class="section container tools" aria-label={t(lang, 'nav.whatToCook')}>
    <a class="tool" href={u('/ledusskapis/')} style="--c:#2f7f86">
      <span class="tool-emoji" aria-hidden="true">🧊</span>
      <span class="tool-text">
        <strong>{t(lang, 'home.toolFridgeTitle')}</strong>
        <span>{t(lang, 'home.toolFridgeText')}</span>
      </span>
      <Icon name="arrow-right" class="tool-arrow" />
    </a>
    <a class="tool" href={u('/tinderis/')} style="--c:#c2334d">
      <span class="tool-emoji" aria-hidden="true">🔥</span>
      <span class="tool-text">
        <strong>{t(lang, 'home.toolTinderTitle')}</strong>
        <span>{t(lang, 'home.toolTinderText')}</span>
      </span>
      <Icon name="arrow-right" class="tool-arrow" />
    </a>
    <a class="tool" href={u('/svetki/')} style="--c:#b8912a">
      <span class="tool-emoji" aria-hidden="true">🎉</span>
      <span class="tool-text">
        <strong>{t(lang, 'home.toolOccasionsTitle')}</strong>
        <span>{t(lang, 'home.toolOccasionsText')}</span>
      </span>
      <Icon name="arrow-right" class="tool-arrow" />
    </a>
  </section>

  <!-- Featured -->
  {
    featured.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <div>
            <span class="eyebrow">{t(lang, 'home.featuredEyebrow')}</span>
            <h2>{t(lang, 'home.featuredTitle')}</h2>
          </div>
          <a class="link-more" href={u('/receptes/')}>
            {t(lang, 'common.all')} <Icon name="arrow-right" />
          </a>
        </div>
        <div class="rail">
          {featured.map((r, i) => (
            <RecipeCard
              recipe={r}
              cuisine={cuisineById.get(r.data.cuisine.id)}
              category={categoryById.get(r.data.category.id)}
              wide
              eager={i < 2}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Categories -->
  <section class="section container" aria-labelledby="cat-title">
    <div class="section-head">
      <div>
        <span class="eyebrow">{t(lang, 'home.categoriesEyebrow')}</span>
        <h2 id="cat-title">{t(lang, 'home.categoriesTitle')}</h2>
      </div>
    </div>
    <div class="rail cat-rail">
      {
        categories.map((c) => (
          <a class="cat-bubble" href={categoryUrl(c.id, lang)} style={`--c:${c.data.color}`}>
            <span class="bubble" aria-hidden="true">
              {c.data.emoji}
            </span>
            {c.data.name}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Cuisines directory -->
  <section class="section container" aria-labelledby="cuisine-title">
    <div class="section-head">
      <div>
        <span class="eyebrow">{t(lang, 'home.cuisinesEyebrow')}</span>
        <h2 id="cuisine-title">{t(lang, 'home.cuisinesTitle')}</h2>
      </div>
      <a class="link-more" href={u('/virtuves/')}>
        {t(lang, 'common.all')} <Icon name="arrow-right" />
      </a>
    </div>
    <div class="cuisine-grid">
      {
        topCuisines.map((c, i) => {
          const n = countBy('cuisine', c.id);
          return (
            <a class:list={['cuisine-tile', { 'cuisine-tile--featured': i === 0 }]} href={cuisineUrl(c.id, lang)} style={`--c:${c.data.color}`}>
              <div>
                <h3>{c.data.name}</h3>
                {c.data.region && <p class="region">{c.data.region}</p>}
              </div>
              <span class="count">{count(lang, n, 'count.recipes')}</span>
              <span class="emoji" aria-hidden="true">
                {c.data.emoji}
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- Sweets & preserves promo -->
  <section class="section container promo-wrap">
    {
      promo.map((c) => {
        const n = countBy('category', c.id);
        return (
          <a class="promo" href={categoryUrl(c.id, lang)} style={`--c:${c.data.color}`}>
            <div>
              <span class="eyebrow">{count(lang, n, 'count.recipes')}</span>
              <h2>{c.data.name}</h2>
              <p>{c.data.description}</p>
              <span class="btn btn-ghost promo-btn">
                {t(lang, 'common.view')} <Icon name="arrow-right" />
              </span>
            </div>
            <span class="promo-emoji" aria-hidden="true">
              {c.data.emoji}
            </span>
          </a>
        );
      })
    }
  </section>

  <div class="container">
    <AdSlot slot="inFeed" />
  </div>

  <!-- Latvian classics -->
  {
    latvian.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <div>
            <span class="eyebrow">{t(lang, 'home.latvianEyebrow')}</span>
            <h2>{t(lang, 'home.latvianTitle')}</h2>
          </div>
          <a class="link-more" href={cuisineUrl('latviesu', lang)}>
            {t(lang, 'common.all')} <Icon name="arrow-right" />
          </a>
        </div>
        <div class="rail">
          {latvian.map((r) => (
            <RecipeCard recipe={r} cuisine={cuisineById.get(r.data.cuisine.id)} category={categoryById.get(r.data.category.id)} wide showBadge={false} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Simple comfort food -->
  {
    comfort.length > 0 && (
      <section class="section container">
        <div class="section-head">
          <div>
            <span class="eyebrow">{t(lang, 'home.comfortEyebrow')}</span>
            <h2>{t(lang, 'home.comfortTitle')}</h2>
          </div>
          <a class="link-more" href={cozyQuery}>
            {t(lang, 'common.all')} <Icon name="arrow-right" />
          </a>
        </div>
        <div class="rail">
          {comfort.map((r) => (
            <RecipeCard recipe={r} cuisine={cuisineById.get(r.data.cuisine.id)} category={categoryById.get(r.data.category.id)} wide />
          ))}
        </div>
      </section>
    )
  }

  <!-- Latest -->
  <section class="section container">
    <div class="section-head">
      <div>
        <span class="eyebrow">{t(lang, 'home.latestEyebrow')}</span>
        <h2>{t(lang, 'home.latestTitle')}</h2>
      </div>
      <a class="link-more" href={u('/receptes/')}>
        {t(lang, 'common.all')} <Icon name="arrow-right" />
      </a>
    </div>
    <div class="grid">
      {latest.map((r) => <RecipeCard recipe={r} cuisine={cuisineById.get(r.data.cuisine.id)} category={categoryById.get(r.data.category.id)} />)}
    </div>
    <div class="more-cta">
      <a class="btn btn-primary" href={u('/receptes/')}>
        {t(lang, 'home.viewAll', { n: recipes.length })} <Icon name="arrow-right" />
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    padding-top: 20px;
    padding-bottom: 12px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: 56px;
      padding-top: 48px;
      padding-bottom: 32px;
    }
  }
  .hero h1 {
    font-size: clamp(2.6rem, 1.6rem + 5vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin-top: 10px;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--brand);
  }
  .hero-copy > p {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: 1.05rem;
    max-width: 46ch;
  }
  .hero-search {
    margin-top: 22px;
    max-width: 520px;
  }
  .hero-chips {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: 2px;
  }
  .hero-chips::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 900px) {
    .hero-chips {
      flex-wrap: wrap;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
  .hero-stats {
    display: flex;
    gap: 28px;
    margin-top: 26px;
  }
  .hero-stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .hero-stats dd {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1;
    margin: 0;
  }
  .hero-stats dt {
    font-size: 0.78rem;
    color: var(--ink-3);
    margin-top: 4px;
  }

  .hero-feature {
    position: relative;
    display: block;
    border-radius: var(--r-lg);
    overflow: hidden;
    aspect-ratio: 16 / 12;
    box-shadow: var(--shadow-lg);
    isolation: isolate;
  }
  @media (min-width: 900px) {
    .hero-feature {
      aspect-ratio: 4 / 4.6;
      transform: rotate(1.5deg);
      transition: transform 0.5s var(--ease);
    }
    .hero-feature:hover {
      transform: rotate(0deg) scale(1.01);
    }
  }
  .hero-feature-media,
  .hero-feature-media :global(img),
  .hero-feature-media :global(.art) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-feature-card {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 16px 18px;
    border-radius: var(--r);
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: var(--shadow);
  }
  .hero-feature-card h2 {
    font-size: 1.45rem;
    margin-top: 4px;
  }
  .hero-feature-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .hero-feature-meta :global(svg) {
    width: 16px;
    height: 16px;
  }
  .dot {
    opacity: 0.5;
  }

  .cat-rail {
    gap: 6px;
  }

  .promo-wrap {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 760px) {
    .promo-wrap {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }
  .promo {
    --c: var(--brand);
    position: relative;
    display: flex;
    overflow: hidden;
    min-height: 200px;
    padding: 24px;
    border-radius: var(--r-lg);
    background:
      radial-gradient(circle at 100% 100%, color-mix(in oklab, var(--c) 30%, transparent), transparent 60%),
      color-mix(in oklab, var(--c) 12%, var(--surface));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c) 20%, transparent);
    isolation: isolate;
    transition: transform 0.25s var(--ease);
  }
  .promo:hover {
    transform: translateY(-3px);
  }
  .promo > div {
    max-width: 62%;
  }
  .promo .eyebrow {
    color: var(--c);
  }
  .promo h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.2rem);
    margin-top: 6px;
  }
  .promo p {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .promo-btn {
    margin-top: 16px;
    min-height: 42px;
    padding: 0 18px;
  }
  .promo-emoji {
    position: absolute;
    right: -10px;
    bottom: -18px;
    font-size: clamp(7rem, 26vw, 10rem);
    line-height: 1;
    transform: rotate(-10deg);
    filter: drop-shadow(0 18px 20px rgb(0 0 0 / 0.2));
    z-index: -1;
    transition: transform 0.5s var(--ease);
  }
  .promo:hover .promo-emoji {
    transform: rotate(0deg) scale(1.06);
  }

  .tools {
    display: grid;
    gap: 10px;
    padding-top: 12px;
  }
  @media (min-width: 800px) {
    .tools {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  .tool {
    --c: var(--brand);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-radius: var(--r);
    background: color-mix(in oklab, var(--c) 10%, var(--surface));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c) 20%, transparent);
    transition: transform 0.2s var(--ease);
  }
  .tool:hover {
    transform: translateY(-3px);
  }
  .tool:active {
    transform: scale(0.98);
  }
  .tool-emoji {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    border-radius: 18px;
    background: var(--c);
    font-size: 1.7rem;
    box-shadow: 0 10px 20px -10px var(--c);
  }
  .tool-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .tool-text strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .tool-text span {
    font-size: 0.84rem;
    color: var(--ink-2);
    line-height: 1.4;
  }
  .tool :global(.tool-arrow) {
    margin-left: auto;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--c);
  }
  .more-cta {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }
</style>
