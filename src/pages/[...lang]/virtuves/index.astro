---
import Base from '../../../layouts/Base.astro';
import { getCatalog, cuisineUrl } from '../../../lib/recipes';
import { langFromPath, langPaths, t, count as countText, type UIKey } from '../../../i18n';

export const getStaticPaths = langPaths;

const lang = langFromPath(Astro.url.pathname);
const { recipes, cuisines } = await getCatalog(lang);
const count = (id: string) => recipes.filter((r) => r.data.cuisine.id === id).length;

const continents = [
  { id: 'Eiropa', emoji: '🏰' },
  { id: 'Āzija', emoji: '🏯' },
  { id: 'Tuvie Austrumi un Āfrika', emoji: '🕌' },
  { id: 'Amerika', emoji: '🗽' },
]
  .map((c) => ({ ...c, name: t(lang, `continent.${c.id}` as UIKey), cuisines: cuisines.filter((x) => x.data.continent === c.id && count(x.id) > 0) }))
  .filter((c) => c.cuisines.length);
---

<Base title={t(lang, 'cuisines.title')} description={t(lang, 'cuisines.metaDesc')}>
  <section class="page-hero container">
    <span class="eyebrow">{t(lang, 'cuisines.eyebrow')}</span>
    <h1>{t(lang, 'cuisines.title')}</h1>
    <p>{t(lang, 'cuisines.lead')}</p>
    <nav class="jump" aria-label={t(lang, 'cuisines.continents')}>
      {
        continents.map((c) => (
          <a class="chip" href={`#${c.id.toLowerCase().replace(/\s+/g, '-')}`}>
            <span aria-hidden="true">{c.emoji}</span> {c.name}
          </a>
        ))
      }
    </nav>
  </section>

  {
    continents.map((c) => (
      <section class="section container" id={c.id.toLowerCase().replace(/\s+/g, '-')} aria-labelledby={`h-${c.id}`}>
        <div class="section-head">
          <div>
            <span class="eyebrow">
              {countText(lang, c.cuisines.length, 'count.cuisines')}
            </span>
            <h2 id={`h-${c.id}`}>
              <span aria-hidden="true">{c.emoji}</span> {c.name}
            </h2>
          </div>
        </div>
        <div class="cuisine-grid cuisines-page">
          {c.cuisines.map((x) => {
            const n = count(x.id);
            return (
              <a class:list={['cuisine-tile', { 'cuisine-tile--featured': x.id === 'latviesu' }]} href={cuisineUrl(x.id, lang)} style={`--c:${x.data.color}`}>
                <div>
                  <h3>{x.data.name}</h3>
                  <p class="region">{x.data.description}</p>
                </div>
                <span class="count">
                  {countText(lang, n, 'count.recipes')}
                </span>
                <span class="emoji" aria-hidden="true">
                  {x.data.emoji}
                </span>
              </a>
            );
          })}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .jump {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  .jump::-webkit-scrollbar {
    display: none;
  }
  .cuisines-page :global(.cuisine-tile) {
    min-height: 170px;
  }
  .cuisines-page :global(.region) {
    max-width: 78%;
  }
</style>
