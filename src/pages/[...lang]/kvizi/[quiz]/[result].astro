---
import Base from '../../../../layouts/Base.astro';
import QuizCard from '../../../../components/QuizCard.astro';
import RecipeCard from '../../../../components/RecipeCard.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import Icon from '../../../../components/Icon.astro';
import { dishIconSvg } from '../../../../lib/dishIcons';
import { getCatalog, cuisineUrl } from '../../../../lib/recipes';
import {
  announceResult,
  getQuizzes,
  quizResultImage,
  quizResultUrl,
  quizUrl,
  quizzesUrl,
  QUIZ_IMAGE_SIZES,
} from '../../../../lib/quizzes';
import { MINE_KEY } from '../../../../lib/quizScore';
import { absolute, breadcrumbLd } from '../../../../lib/seo';
import { LANGS, langParam, href, t, type Lang } from '../../../../i18n';

export async function getStaticPaths() {
  const quizzes = await getQuizzes('lv');
  return LANGS.flatMap((lang) =>
    quizzes.flatMap((q) => q.results.map((r) => ({ params: { lang: langParam(lang), quiz: q.id, result: r.id }, props: { lang } }))),
  );
}

const { lang } = Astro.props as { lang: Lang };
const quizzes = await getQuizzes(lang);
const quiz = quizzes.find((q) => q.id === Astro.params.quiz)!;
const r = quiz.results.find((x) => x.id === Astro.params.result)!;
const match = quiz.results.find((x) => x.id === r.match)!;
const { recipes, cuisineById, categoryById } = await getCatalog(lang);
const picks = r.recipes.map((id) => recipes.find((x) => x.id === id)!).filter(Boolean);
const cuisine = r.cuisine ? cuisineById.get(r.cuisine) : undefined;
const index = quizzes.indexOf(quiz);
const others = [1, 2, 3].map((k) => quizzes[(index + k) % quizzes.length]);

const line = announceResult(quiz, r, lang);
const pageUrl = absolute(quizResultUrl(quiz.id, r.id, lang), Astro.site);
const shareText = `${line} ${r.emoji} ${quiz.title}`;
const enc = encodeURIComponent;
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}`,
  whatsapp: `https://wa.me/?text=${enc(`${shareText} ${pageUrl}`)}`,
  telegram: `https://t.me/share/url?url=${enc(pageUrl)}&text=${enc(shareText)}`,
  x: `https://x.com/intent/post?text=${enc(shareText)}&url=${enc(pageUrl)}`,
};
const storyImage = quizResultImage(quiz.id, r.id, lang, 'story');
const art = dishIconSvg(r.icon, r.name);
const jsonLd = breadcrumbLd(
  [
    { name: t(lang, 'nav.home'), path: href(lang, '/') },
    { name: t(lang, 'quiz.hubTitle'), path: quizzesUrl(lang) },
    { name: quiz.title, path: quizUrl(quiz.id, lang) },
    { name: r.name, path: quizResultUrl(quiz.id, r.id, lang) },
  ],
  Astro.site,
);
---

<Base
  title={`${line} ${r.emoji} · ${quiz.title}`}
  description={t(lang, 'quiz.metaDesc', { tagline: r.tagline, quiz: quiz.title })}
  image={quizResultImage(quiz.id, r.id, lang, 'og')}
  imageSize={QUIZ_IMAGE_SIZES.og}
  imageAlt={line}
  jsonLd={jsonLd}
>
  <div class="container result" style={`--qc:${r.color}`} data-result data-share-text={shareText} data-share-url={pageUrl}>
    <script is:inline define:vars={{ key: MINE_KEY, value: `${quiz.id}/${r.id}` }}>
      // The person who just took the quiz sees the sharing tools first; everyone else sees an invitation.
      try {
        if (sessionStorage.getItem(key) === value) document.currentScript.parentElement.classList.add('is-mine');
      } catch (e) {}
    </script>

    <article class="card-result">
      <p class="kicker">
        <span class="for-mine">{t(lang, 'quiz.yourResult')}</span>
        <span class="for-visitor">{t(lang, 'quiz.friendResult', { quiz: quiz.title })}</span>
      </p>
      <div class="art">
        {art ? <Fragment set:html={art} /> : <span class="art-emoji">{r.emoji}</span>}
        <span class="badge" aria-hidden="true">{r.emoji}</span>
      </div>
      <h1>{r.name}</h1>
      <p class="tagline">{r.tagline}</p>
      <p class="desc">{r.description}</p>
      <div class="traits">
        <h2 class="sr-only">{t(lang, 'quiz.traits')}</h2>
        {r.traits.map((x) => <span class="trait">{x}</span>)}
      </div>

      <a class="btn btn-primary cta for-visitor" href={quizUrl(quiz.id, lang)}>
        {t(lang, 'quiz.takeIt')} <span aria-hidden="true">→</span>
      </a>
    </article>

    <section class="share" aria-labelledby="share-title">
      <h2 id="share-title">{t(lang, 'quiz.shareTitle')}</h2>
      <p class="share-hint">{t(lang, 'quiz.shareHint')}</p>
      <div class="share-row">
        <a class="sh sh-fb" href={share.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5V6.8c0-.8.5-1 .9-1H17V2.1L14 2c-3.3 0-4 2.4-4 4v2.5H7.5V12H10v10h4V12h2.9l.4-3.5H14z" /></svg>
          <span>Facebook</span>
        </a>
        <a class="sh sh-wa" href={share.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1 2.7c.2.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z" /></svg>
          <span>WhatsApp</span>
        </a>
        <a class="sh sh-tg" href={share.telegram} target="_blank" rel="noopener" aria-label="Telegram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2L6.5 13.2l-4.7-1.5c-1-.3-1-1 .2-1.5L20.5 3c.9-.3 1.6.2 1.4 1.3z" /></svg>
          <span>Telegram</span>
        </a>
        <a class="sh sh-x" href={share.x} target="_blank" rel="noopener" aria-label="X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.3L5.3 21H2.2l7.2-8.3L1.9 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.5l11.2 14.5z" /></svg>
          <span>X</span>
        </a>
        <button type="button" class="sh sh-copy" data-copy>
          <Icon name="link" />
          <span>{t(lang, 'quiz.copy')}</span>
        </button>
        <button type="button" class="sh sh-more" data-native hidden>
          <Icon name="share" />
          <span>{t(lang, 'quiz.more')}</span>
        </button>
      </div>
      <a class="story" href={storyImage} download={`dzervene-${quiz.id}-${r.id}.jpg`}>
        <img src={storyImage} alt="" width="54" height="96" loading="lazy" decoding="async" />
        <span>
          <strong>{t(lang, 'quiz.story')}</strong>
          <small>{t(lang, 'quiz.storyHint')}</small>
        </span>
      </a>
      <a class="retake for-mine" href={quizUrl(quiz.id, lang)}>{t(lang, 'quiz.retake')}</a>
    </section>

    <section class="match">
      <h2>{t(lang, 'quiz.match')}</h2>
      <a class="match-card" href={quizResultUrl(quiz.id, match.id, lang)} style={`--mc:${match.color}`}>
        <span class="match-emoji" aria-hidden="true">{match.emoji}</span>
        <span>
          <strong>{match.name}</strong>
          <small>{match.tagline}</small>
        </span>
      </a>
      <p class="match-hint">{t(lang, 'quiz.matchHint')}</p>
    </section>

    <section class="recipes">
      <div class="section-head">
        <h2>{t(lang, 'quiz.recipesTitle')}</h2>
        {cuisine && <a class="link-more" href={cuisineUrl(cuisine.id, lang)}>{t(lang, 'quiz.cuisineLink')}</a>}
      </div>
      <div class="grid recipe-grid">
        {
          picks.map((p) => (
            <RecipeCard recipe={p} cuisine={cuisineById.get(p.data.cuisine?.id ?? '')} category={categoryById.get(p.data.category.id)} />
          ))
        }
      </div>
    </section>

    <AdSlot slot="quizResult" />

    <section class="more">
      <div class="section-head">
        <h2>{t(lang, 'quiz.nextTitle')}</h2>
        <a class="link-more" href={quizzesUrl(lang)}>{t(lang, 'quiz.allQuizzes')}</a>
      </div>
      <div class="more-grid">{others.map((q) => <QuizCard quiz={q} />)}</div>
    </section>
  </div>
</Base>

<script>
  import { toast } from '../../../../lib/favorites';
  import { ct } from '../../../../i18n/client';

  const root = document.querySelector<HTMLElement>('[data-result]');
  if (root) {
    const url = root.dataset.shareUrl!;
    const text = root.dataset.shareText!;
    root.querySelector('[data-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        toast(ct('share.copied'));
      } catch {
        prompt('', url);
      }
    });
    const native = root.querySelector<HTMLButtonElement>('[data-native]');
    if (native && 'share' in navigator) {
      native.hidden = false;
      native.addEventListener('click', async () => {
        try {
          await navigator.share({ title: document.title, text, url });
        } catch {
          /* the share sheet was closed */
        }
      });
    }
  }
</script>

<style>
  .result {
    padding-top: 24px;
    padding-bottom: 40px;
    display: grid;
    gap: 28px;
  }
  .result > * {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
  }
  .result > .recipes,
  .result > .more,
  .result > :global(.ad) {
    max-width: none;
  }
  /* Visitor view by default; the inline script switches to the owner's view. */
  .result:not(:global(.is-mine)) .for-mine,
  .result:global(.is-mine) .for-visitor {
    display: none !important;
  }
  .card-result {
    position: relative;
    text-align: center;
    padding: 24px 20px 28px;
    border-radius: var(--r-lg);
    background:
      radial-gradient(circle at 50% 0%, rgb(255 255 255 / 0.75), transparent 55%),
      linear-gradient(160deg, color-mix(in oklab, var(--qc) 12%, var(--surface)), color-mix(in oklab, var(--qc) 26%, var(--surface)));
    box-shadow: var(--shadow), inset 0 0 0 1px var(--line);
    animation: reveal 0.6s var(--ease);
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
  }
  .kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--qc) 75%, var(--ink));
  }
  .art {
    position: relative;
    width: min(240px, 62vw);
    aspect-ratio: 1;
    margin: 10px auto 4px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 255 255 / 0.95) 45%, rgb(255 255 255 / 0) 70%);
  }
  .art :global(.dish-icon) {
    width: 88%;
    height: 88%;
    filter: drop-shadow(0 10px 14px rgb(40 25 10 / 0.18));
  }
  .art-emoji {
    font-size: 6rem;
  }
  .badge {
    position: absolute;
    right: 6%;
    bottom: 8%;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--surface);
    font-size: 1.8rem;
    box-shadow: var(--shadow);
  }
  h1 {
    font-size: clamp(2.2rem, 1.6rem + 3vw, 3.4rem);
    line-height: 1.08;
  }
  .tagline {
    margin-top: 8px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 1rem + 0.8vw, 1.45rem);
    color: color-mix(in oklab, var(--qc) 70%, var(--ink));
  }
  .desc {
    max-width: 560px;
    margin: 14px auto 0;
    color: var(--ink-2);
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .traits {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
  }
  .trait {
    padding: 7px 14px;
    border-radius: var(--pill);
    background: var(--surface);
    font-weight: 600;
    font-size: 0.88rem;
    color: color-mix(in oklab, var(--qc) 75%, var(--ink));
    box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--qc) 30%, transparent);
  }
  .cta {
    margin-top: 22px;
    min-height: 54px;
    padding-inline: 26px;
    font-size: 1rem;
    white-space: normal;
    background: var(--qc);
    box-shadow: 0 10px 24px -10px var(--qc);
  }
  .cta:hover {
    background: color-mix(in oklab, var(--qc) 85%, black);
  }
  .share {
    text-align: center;
  }
  .share h2,
  .match h2 {
    font-size: 1.4rem;
  }
  .share-hint {
    color: var(--ink-2);
    margin-top: 4px;
    font-size: 0.95rem;
  }
  .share-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }
  .sh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 16px;
    border-radius: var(--pill);
    font-weight: 600;
    font-size: 0.9rem;
    color: #fff;
    transition: transform 0.15s var(--ease), filter 0.15s;
  }
  .sh:hover {
    filter: brightness(1.08);
  }
  .sh:active {
    transform: scale(0.96);
  }
  .sh svg,
  .sh :global(svg) {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .sh[hidden] {
    display: none;
  }
  .sh-fb {
    background: #1877f2;
  }
  .sh-wa {
    background: #1faa53;
  }
  .sh-tg {
    background: #229ed9;
  }
  .sh-x {
    background: #111;
  }
  .sh-copy,
  .sh-more {
    background: var(--surface);
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }
  .sh-copy :global(svg),
  .sh-more :global(svg) {
    fill: none;
  }
  .story {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    padding: 8px 18px 8px 8px;
    border-radius: var(--r);
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    text-align: left;
  }
  .story img {
    width: 36px;
    height: 64px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--surface-2);
  }
  .story strong,
  .story small {
    display: block;
  }
  .story small {
    color: var(--ink-3);
  }
  .retake {
    display: table;
    margin: 16px auto 0;
    font-weight: 600;
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .match {
    text-align: center;
  }
  .match-card {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 440px;
    margin: 12px auto 0;
    padding: 12px 18px 12px 12px;
    border-radius: var(--r);
    background: color-mix(in oklab, var(--mc) 10%, var(--surface));
    box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--mc) 30%, transparent);
    text-align: left;
    transition: transform 0.2s var(--ease);
  }
  .match-card:hover {
    transform: translateY(-2px);
  }
  .match-emoji {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--surface);
    font-size: 1.7rem;
    box-shadow: var(--shadow-sm);
  }
  .match-card strong,
  .match-card small {
    display: block;
  }
  .match-card small {
    color: var(--ink-2);
  }
  .match-hint {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .recipe-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 700px) {
    .recipe-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .more-grid {
    display: grid;
    gap: 18px;
  }
  @media (min-width: 700px) {
    .more-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (prefers-color-scheme: dark) {
    .card-result {
      background: linear-gradient(160deg, color-mix(in oklab, var(--qc) 16%, var(--surface)), color-mix(in oklab, var(--qc) 30%, var(--surface)));
    }
    .art {
      background: radial-gradient(circle, rgb(255 255 255 / 0.12) 45%, rgb(255 255 255 / 0) 70%);
    }
    .kicker,
    .tagline,
    .trait {
      color: color-mix(in oklab, var(--qc) 50%, var(--ink));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-result {
      animation: none;
    }
  }
</style>
