---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import RecipeArt from '../../components/RecipeArt.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import FavButton from '../../components/FavButton.astro';
import AdSlot from '../../components/AdSlot.astro';
import { SITE } from '../../site.config';
import {
  getCatalog,
  getRecipes,
  formatMinutes,
  formatAmount,
  totalTime,
  cuisineUrl,
  categoryUrl,
  imageUrl,
  type Recipe,
} from '../../lib/recipes';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props as { recipe: Recipe };
const d = recipe.data;
const { recipes, cuisineById, categoryById } = await getCatalog();
const cuisine = cuisineById.get(d.cuisine.id);
const category = categoryById.get(d.category.id);
const { Content } = await render(recipe);
const hasStory = recipe.body?.trim().length;

const emoji = d.emoji || category?.data.emoji || '🍽️';
const color = category?.data.color || cuisine?.data.color || '#9e3039';
const total = totalTime(recipe);

// Group ingredients by their optional "group" field, keeping the original order.
const groups: { name?: string; items: typeof d.ingredients }[] = [];
for (const ing of d.ingredients) {
  const last = groups[groups.length - 1];
  if (last && last.name === ing.group) last.items.push(ing);
  else groups.push({ name: ing.group, items: [ing] });
}

/** Finds "10 minūtes", "3 līdz 4 minūtes" or "1,5 stundas" in a step and returns seconds. */
function detectTimer(text: string): number | null {
  const m = text.match(/(\d+(?:[.,]\d+)?)(?:\s*(?:līdz|-)\s*(\d+(?:[.,]\d+)?))?\s*(minūt|min\b|stund)/i);
  if (!m) return null;
  const value = parseFloat((m[2] || m[1]).replace(',', '.'));
  const secs = Math.round(value * (m[3].toLowerCase().startsWith('stund') ? 3600 : 60));
  return secs > 0 && secs <= 6 * 3600 ? secs : null;
}
const steps = d.steps.map((text) => ({ text, timer: detectTimer(text) }));

const ingredientText = (i: (typeof d.ingredients)[number]) =>
  [i.amount ? formatAmount(i.amount) : '', i.unit, i.name].filter(Boolean).join(' ');

// Related: same category first, then same cuisine.
const related = recipes
  .filter((r) => r.id !== recipe.id)
  .map((r) => ({
    r,
    score: (r.data.category.id === d.category.id ? 2 : 0) + (r.data.cuisine.id === d.cuisine.id ? 1 : 0) + (r.data.tags.some((t) => d.tags.includes(t)) ? 1 : 0),
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 8)
  .map((x) => x.r);

const iso = (min: number) => `PT${min}M`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.description,
  image: d.image ? [new URL(d.image, Astro.site).href] : undefined,
  author: { '@type': 'Organization', name: SITE.name },
  datePublished: d.date.toISOString().slice(0, 10),
  inLanguage: 'lv',
  prepTime: iso(d.prepTime),
  cookTime: iso(d.cookTime),
  totalTime: iso(total),
  recipeYield: d.yield || `${d.servings} porcijas`,
  recipeCategory: category?.data.name,
  recipeCuisine: cuisine?.data.name,
  keywords: d.tags.join(', '),
  recipeIngredient: d.ingredients.map(ingredientText),
  recipeInstructions: d.steps.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
};

const useMultiplier = Boolean(d.yield);
---

<Base
  title={d.title}
  description={d.description}
  image={d.image ? imageUrl(d.image, 1200) : undefined}
  type="article"
  jsonLd={jsonLd}
>
  <article class="recipe" data-recipe-page data-servings={d.servings}>
    <!-- Hero -->
    <header class="r-hero container">
      <div class="r-media">
        <RecipeArt image={d.image} emoji={emoji} color={color} alt={d.title} sizes="(min-width: 900px) 560px, 100vw" large eager />
        <div class="r-media-actions no-print">
          <a class="fav-btn" href={categoryUrl(d.category.id)} aria-label={`Atpakaļ uz: ${category?.data.name}`}>
            <Icon name="chevron-left" />
          </a>
          <FavButton id={recipe.id} title={d.title} />
        </div>
      </div>

      <div class="r-head">
        <nav class="r-tags" aria-label="Virtuve un kategorija">
          {cuisine && <a class="chip" href={cuisineUrl(cuisine.id)}><span aria-hidden="true">{cuisine.data.emoji}</span>{cuisine.data.name}</a>}
          {category && <a class="chip" href={categoryUrl(category.id)}><span aria-hidden="true">{category.data.emoji}</span>{category.data.name}</a>}
        </nav>
        <h1>{d.title}</h1>
        <p class="r-desc">{d.description}</p>

        <dl class="r-stats">
          <div><dt>Sagatavošana</dt><dd>{formatMinutes(d.prepTime)}</dd></div>
          <div><dt>Gatavošana</dt><dd>{formatMinutes(d.cookTime)}</dd></div>
          <div><dt>Kopā</dt><dd>{formatMinutes(total)}</dd></div>
          <div><dt>Grūtība</dt><dd class="cap">{d.difficulty}</dd></div>
        </dl>

        <div class="r-actions no-print" data-hero-actions>
          <button type="button" class="btn btn-primary" data-cook-open>
            <Icon name="play" /> Sākt gatavot
          </button>
          <button type="button" class="icon-btn outline" data-share aria-label="Dalīties">
            <Icon name="share" />
          </button>
          <button type="button" class="icon-btn outline" data-print aria-label="Drukāt">
            <Icon name="printer" />
          </button>
        </div>
      </div>
    </header>

    {
      hasStory && (
        <section class="container r-story">
          <Content />
        </section>
      )
    }

    <div class="container"><AdSlot slot="recipeTop" /></div>

    <div class="container r-body">
      <!-- Ingredients -->
      <section class="r-ingredients" aria-labelledby="ing-title">
        <div class="panel">
          <div class="panel-head">
            <h2 id="ing-title">Sastāvdaļas</h2>
            {
              useMultiplier ? (
                <div class="seg no-print" role="group" aria-label="Daudzums" data-multiplier>
                  {[0.5, 1, 2, 3].map((m) => (
                    <button type="button" data-factor={m} aria-pressed={m === 1 ? 'true' : 'false'}>
                      {m === 0.5 ? '½' : m}×
                    </button>
                  ))}
                </div>
              ) : (
                <div class="stepper no-print" data-stepper>
                  <button type="button" class="icon-btn" data-step="-1" aria-label="Mazāk porciju"><Icon name="minus" /></button>
                  <span><strong data-servings-out>{d.servings}</strong> porc.</span>
                  <button type="button" class="icon-btn" data-step="1" aria-label="Vairāk porciju"><Icon name="plus" /></button>
                </div>
              )
            }
          </div>
          {d.yield && <p class="yield"><Icon name="users" /> Daudzums: {d.yield}</p>}

          {
            groups.map((g) => (
              <div class="ing-group">
                {g.name && <h3>{g.name}</h3>}
                <ul>
                  {g.items.map((i) => (
                    <li>
                      <label class="ing">
                        <input type="checkbox" />
                        <span class="tick" aria-hidden="true"><Icon name="check" /></span>
                        <span class="ing-text">
                          {i.amount ? (
                            <b class="qty" data-amount={i.amount}>
                              {formatAmount(i.amount)}
                              {i.unit ? ` ${i.unit}` : ''}
                            </b>
                          ) : (
                            i.unit && <b class="qty">{i.unit}</b>
                          )}{' '}
                          {i.name}
                        </span>
                      </label>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Steps -->
      <section class="r-steps" aria-labelledby="steps-title">
        <h2 id="steps-title">Pagatavošana</h2>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="step" data-step-index={i}>
                <button type="button" class="step-num" aria-label={`Atzīmēt ${i + 1}. soli kā paveiktu`}>
                  <span class="n">{i + 1}</span>
                  <Icon name="check" class="c" />
                </button>
                <div class="step-body">
                  <p>{s.text}</p>
                  {s.timer && (
                    <button type="button" class="timer-chip no-print" data-timer={s.timer} data-timer-label={`${i + 1}. solis`}>
                      <Icon name="timer" /> Taimeris {formatMinutes(Math.round(s.timer / 60))}
                    </button>
                  )}
                </div>
              </li>
            ))
          }
        </ol>

        {
          d.tips.length > 0 && (
            <aside class="tips">
              <h3><Icon name="bulb" /> Padomi</h3>
              <ul>
                {d.tips.map((t) => <li>{t}</li>)}
              </ul>
            </aside>
          )
        }

        {
          d.tags.length > 0 && (
            <div class="r-tagcloud">
              {d.tags.map((t) => <a class="chip" href={`/receptes/?q=${encodeURIComponent(t)}`}>#{t}</a>)}
            </div>
          )
        }
      </section>
    </div>

    <div class="container"><AdSlot slot="recipeBottom" /></div>

    {
      related.length > 0 && (
        <section class="section container no-print">
          <div class="section-head">
            <div>
              <span class="eyebrow">Tev varētu garšot</span>
              <h2>Līdzīgas receptes</h2>
            </div>
          </div>
          <div class="rail">
            {related.map((r) => (
              <RecipeCard recipe={r} cuisine={cuisineById.get(r.data.cuisine.id)} category={categoryById.get(r.data.category.id)} wide />
            ))}
          </div>
        </section>
      )
    }

    <!-- Floating CTA (mobile) -->
    <button type="button" class="float-cta btn btn-primary no-print" data-cook-open data-float-cta>
      <Icon name="play" /> Sākt gatavot
    </button>

    <!-- Running timer pill -->
    <div class="timer-pill no-print" data-timer-pill hidden>
      <Icon name="timer" />
      <span data-timer-label-out></span>
      <strong data-timer-out>0:00</strong>
      <button type="button" data-timer-toggle aria-label="Pauze"><Icon name="pause" /></button>
      <button type="button" data-timer-cancel aria-label="Atcelt taimeri"><Icon name="x" /></button>
    </div>

    <!-- Cooking mode -->
    <dialog class="cook" data-cook aria-label={`Gatavošanas režīms: ${d.title}`}>
      <div class="cook-inner">
        <header class="cook-top">
          <button type="button" class="icon-btn" data-cook-close aria-label="Aizvērt gatavošanas režīmu"><Icon name="x" /></button>
          <div class="cook-title">
            <span data-cook-count>1 / {steps.length}</span>
            <strong>{d.title}</strong>
          </div>
          <button type="button" class="icon-btn" data-cook-ing aria-label="Rādīt sastāvdaļas"><Icon name="list" /></button>
        </header>
        <div class="cook-progress"><span data-cook-bar></span></div>

        <div class="cook-stage" data-cook-stage>
          {
            steps.map((s, i) => (
              <section class="cook-step" data-cook-step={i} hidden={i !== 0}>
                <span class="cook-step-n">Solis {i + 1}</span>
                <p>{s.text}</p>
                {s.timer && (
                  <button type="button" class="btn btn-ghost cook-timer" data-timer={s.timer} data-timer-label={`${i + 1}. solis`}>
                    <Icon name="timer" /> Sākt taimeri: {formatMinutes(Math.round(s.timer / 60))}
                  </button>
                )}
              </section>
            ))
          }
          <section class="cook-step cook-done" data-cook-step={steps.length} hidden>
            <span class="big" aria-hidden="true">🎉</span>
            <h2>Labu apetīti!</h2>
            <p>Gatavs! Ja recepte izdevās, saglabā to izlasē.</p>
            <div class="cook-done-actions">
              <FavButton id={recipe.id} title={d.title} class="cook-fav" />
              <button type="button" class="btn btn-primary" data-cook-close>Pabeigt</button>
            </div>
          </section>
        </div>

        <aside class="cook-ing" data-cook-ing-panel hidden>
          <h3>Sastāvdaļas</h3>
          <ul>
            {d.ingredients.map((i) => <li>{ingredientText(i)}</li>)}
          </ul>
        </aside>

        <footer class="cook-nav">
          <button type="button" class="btn btn-ghost" data-cook-prev><Icon name="chevron-left" /> Atpakaļ</button>
          <button type="button" class="btn btn-primary" data-cook-next>Tālāk <Icon name="chevron-right" /></button>
        </footer>
      </div>
    </dialog>
  </article>
</Base>

<script>
  import { formatAmount } from '../../lib/format';
  import { toast } from '../../lib/favorites';

  const page = document.querySelector<HTMLElement>('[data-recipe-page]')!;
  const baseServings = Number(page.dataset.servings) || 1;

  /* ---------- Serving scaler ---------- */
  const qtys = Array.from(page.querySelectorAll<HTMLElement>('.qty[data-amount]'));
  const units = qtys.map((q) => q.textContent!.replace(/^[\d¼⅓½⅔¾,]+/, '').trim());
  // When scaling up, 1500 g reads better as 1,5 kg and 1000 ml as 1 l.
  const BIGGER: Record<string, [string, number]> = { g: ['kg', 1000], ml: ['l', 1000] };
  function scale(factor: number) {
    qtys.forEach((q, i) => {
      let amount = Number(q.dataset.amount) * factor;
      let unit = units[i];
      const up = BIGGER[unit];
      if (up && amount >= up[1]) {
        amount /= up[1];
        unit = up[0];
      }
      q.textContent = formatAmount(amount) + (unit ? ' ' + unit : '');
    });
  }
  const stepper = page.querySelector<HTMLElement>('[data-stepper]');
  if (stepper) {
    let servings = baseServings;
    const out = stepper.querySelector<HTMLElement>('[data-servings-out]')!;
    stepper.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-step]');
      if (!btn) return;
      servings = Math.min(50, Math.max(1, servings + Number(btn.dataset.step)));
      out.textContent = String(servings);
      scale(servings / baseServings);
    });
  }
  const mult = page.querySelector<HTMLElement>('[data-multiplier]');
  mult?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-factor]');
    if (!btn) return;
    mult.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    scale(Number(btn.dataset.factor));
  });

  /* ---------- Step progress (tap the number to mark as done) ---------- */
  page.querySelectorAll<HTMLElement>('.step').forEach((step) => {
    step.querySelector('.step-num')!.addEventListener('click', () => step.classList.toggle('is-done'));
  });

  /* ---------- Share & print ---------- */
  page.querySelector('[data-share]')?.addEventListener('click', async () => {
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(location.href);
        toast('Saite nokopēta 🔗');
      }
    } catch {
      /* user cancelled the share sheet */
    }
  });
  page.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  /* ---------- Floating CTA appears once the hero button is off screen ---------- */
  const heroActions = page.querySelector('[data-hero-actions]');
  const floatCta = page.querySelector<HTMLElement>('[data-float-cta]')!;
  if (heroActions && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => floatCta.classList.toggle('show', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(
      heroActions,
    );
  }

  /* ---------- Timer ---------- */
  const pill = page.querySelector<HTMLElement>('[data-timer-pill]')!;
  const pillOut = pill.querySelector<HTMLElement>('[data-timer-out]')!;
  const pillLabel = pill.querySelector<HTMLElement>('[data-timer-label-out]')!;
  const pillToggle = pill.querySelector<HTMLButtonElement>('[data-timer-toggle]')!;
  let endAt = 0;
  let remaining = 0;
  let tick: number | undefined;
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

  function beep() {
    try {
      const Ctx = window.AudioContext || (window as any).webkitAudioContext;
      const ctx = new Ctx();
      [0, 0.35, 0.7].forEach((t) => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.frequency.value = 880;
        g.gain.setValueAtTime(0.0001, ctx.currentTime + t);
        g.gain.exponentialRampToValueAtTime(0.3, ctx.currentTime + t + 0.02);
        g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + t + 0.3);
        o.connect(g).connect(ctx.destination);
        o.start(ctx.currentTime + t);
        o.stop(ctx.currentTime + t + 0.32);
      });
    } catch {
      /* audio not available */
    }
  }
  function render() {
    const left = Math.max(0, Math.round((endAt - Date.now()) / 1000));
    pillOut.textContent = fmt(left);
    if (left <= 0) {
      window.clearInterval(tick);
      tick = undefined;
      pill.classList.add('done');
      pillOut.textContent = 'Gatavs!';
      beep();
      navigator.vibrate?.([200, 100, 200, 100, 400]);
      toast('⏰ Laiks beidzies!');
    }
  }
  function startTimer(seconds: number, label: string) {
    window.clearInterval(tick);
    endAt = Date.now() + seconds * 1000;
    pill.hidden = false;
    pill.classList.remove('done', 'paused');
    pillLabel.textContent = label;
    render();
    tick = window.setInterval(render, 250);
  }
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-timer]');
    if (btn) startTimer(Number(btn.dataset.timer), btn.dataset.timerLabel || '');
  });
  pillToggle.addEventListener('click', () => {
    if (pill.classList.contains('done')) return;
    if (tick) {
      remaining = endAt - Date.now();
      window.clearInterval(tick);
      tick = undefined;
      pill.classList.add('paused');
    } else {
      endAt = Date.now() + remaining;
      pill.classList.remove('paused');
      tick = window.setInterval(render, 250);
    }
  });
  pill.querySelector('[data-timer-cancel]')!.addEventListener('click', () => {
    window.clearInterval(tick);
    tick = undefined;
    pill.hidden = true;
  });

  /* ---------- Cooking mode ---------- */
  const dialog = page.querySelector<HTMLDialogElement>('[data-cook]')!;
  const cookSteps = Array.from(dialog.querySelectorAll<HTMLElement>('[data-cook-step]'));
  const total = cookSteps.length - 1; // last one is the "done" screen
  const bar = dialog.querySelector<HTMLElement>('[data-cook-bar]')!;
  const counter = dialog.querySelector<HTMLElement>('[data-cook-count]')!;
  const prev = dialog.querySelector<HTMLButtonElement>('[data-cook-prev]')!;
  const next = dialog.querySelector<HTMLButtonElement>('[data-cook-next]')!;
  const ingPanel = dialog.querySelector<HTMLElement>('[data-cook-ing-panel]')!;
  let current = 0;
  let wakeLock: any = null;

  function show(i: number, dir = 1) {
    current = Math.max(0, Math.min(total, i));
    cookSteps.forEach((s, idx) => {
      s.hidden = idx !== current;
      if (idx === current) {
        s.style.setProperty('--dir', String(dir));
        s.classList.remove('enter');
        void s.offsetWidth;
        s.classList.add('enter');
      }
    });
    bar.style.width = `${(Math.min(current + 1, total) / total) * 100}%`;
    counter.textContent = current < total ? `${current + 1} / ${total}` : 'Gatavs';
    prev.disabled = current === 0;
    next.hidden = current === total;
    next.innerHTML = current === total - 1 ? 'Pabeigt ✓' : 'Tālāk <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>';
  }

  async function lockScreen() {
    try {
      wakeLock = await (navigator as any).wakeLock?.request('screen');
    } catch {
      /* not supported or denied */
    }
  }

  page.querySelectorAll('[data-cook-open]').forEach((b) =>
    b.addEventListener('click', () => {
      dialog.showModal();
      document.documentElement.classList.add('cook-open');
      show(0);
      lockScreen();
    }),
  );
  function closeCook() {
    dialog.close();
  }
  dialog.addEventListener('close', () => {
    document.documentElement.classList.remove('cook-open');
    wakeLock?.release?.();
    wakeLock = null;
    ingPanel.hidden = true;
  });
  document.addEventListener('visibilitychange', () => {
    if (dialog.open && document.visibilityState === 'visible') lockScreen();
  });
  dialog.querySelectorAll('[data-cook-close]').forEach((b) => b.addEventListener('click', closeCook));
  prev.addEventListener('click', () => show(current - 1, -1));
  next.addEventListener('click', () => show(current + 1, 1));
  dialog.querySelector('[data-cook-ing]')!.addEventListener('click', () => (ingPanel.hidden = !ingPanel.hidden));
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1, 1);
    if (e.key === 'ArrowLeft') show(current - 1, -1);
  });

  // Swipe left / right between steps.
  let sx = 0;
  let sy = 0;
  const stage = dialog.querySelector<HTMLElement>('[data-cook-stage]')!;
  stage.addEventListener('touchstart', (e) => {
    sx = e.touches[0].clientX;
    sy = e.touches[0].clientY;
  }, { passive: true });
  stage.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - sx;
    const dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
  }, { passive: true });
</script>

<style>
  /* ---------- Hero ---------- */
  .r-hero {
    display: grid;
    gap: 0;
    padding-inline: 0;
  }
  .r-media {
    position: relative;
    aspect-ratio: 1 / 1;
    max-height: 62vh;
    width: 100%;
    overflow: hidden;
    background: var(--surface-2);
  }
  .r-media :global(img),
  .r-media :global(.art) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .r-media-actions {
    position: absolute;
    inset: 12px 12px auto 12px;
    display: flex;
    justify-content: space-between;
  }
  .r-head {
    position: relative;
    margin-top: -28px;
    padding: 24px var(--gutter) 8px;
    background: var(--bg);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }
  @media (min-width: 900px) {
    .r-hero {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
