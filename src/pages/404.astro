---
import Base from '../layouts/Base.astro';
---

<Base title="Lapa nav atrasta" noindex>
  <section class="container notfound">
    <div class="big" aria-hidden="true">🍳</div>
    <h1>Ups, šī lapa ir piedegusi</h1>
    <p>Meklētā lapa neeksistē vai ir pārvietota. Varbūt kāda garšīga recepte palīdzēs?</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Uz sākumu</a>
      <a class="btn btn-ghost" href="/receptes/">Visas receptes</a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    text-align: center;
    padding-block: 72px 40px;
  }
  .big {
    font-size: 5rem;
    line-height: 1;
  }
  h1 {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    margin-top: 16px;
  }
  p {
    color: var(--ink-2);
    margin: 12px auto 0;
    max-width: 44ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }
</style>
