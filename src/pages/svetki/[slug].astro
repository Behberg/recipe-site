---
import Base from '../../layouts/Base.astro';
import TaxonomyHero from '../../components/TaxonomyHero.astro';
import RecipeBrowser from '../../components/RecipeBrowser.astro';
import { getCatalog, getOccasions, type Occasion } from '../../lib/recipes';

export async function getStaticPaths() {
  const occasions = await getOccasions();
  return occasions.map((occasion) => ({ params: { slug: occasion.id }, props: { occasion } }));
}

const { occasion } = Astro.props as { occasion: Occasion };
const { recipes: all, cuisines, categories } = await getCatalog();
const recipes = all.filter((r) => r.data.occasions.some((o) => o.id === occasion.id));
const rule = { id: occasion.id, ...occasion.data };
---

<Base title={`${occasion.data.name}: svētku receptes`} description={occasion.data.description}>
  <TaxonomyHero
    name={occasion.data.name}
    emoji={occasion.data.emoji}
    color={occasion.data.color}
    description={occasion.data.description}
    count={recipes.length}
    parent={{ href: '/svetki/', label: 'Svētku galds' }}
  />
  <div class="container">
    <p class="next-date" data-next-date hidden></p>
  </div>
  <section class="container" style="padding-top:16px">
    {
      recipes.length ? (
        <RecipeBrowser recipes={recipes} cuisines={cuisines} categories={categories} />
      ) : (
        <div class="empty">
          <div class="big">{occasion.data.emoji}</div>
          <h3>Receptes drīzumā</h3>
          <p>Šiem svētkiem receptes vēl tiek gatavotas.</p>
        </div>
      )
    }
  </section>
  <script is:inline type="application/json" id="occ-rule" set:html={JSON.stringify(rule)} />
</Base>

<script>
  import { nextOccurrence, formatDateLong, countdown, type OccasionRule } from '../../lib/calendar';

  const rule: OccasionRule = JSON.parse(document.getElementById('occ-rule')!.textContent!);
  const next = nextOccurrence(rule);
  const el = document.querySelector<HTMLElement>('[data-next-date]')!;
  if (next) {
    el.textContent = `📅 Nākamreiz: ${formatDateLong(next.date)} ${next.date.getFullYear()}, ${countdown(next.days)}`;
    el.hidden = false;
  }
</script>

<style>
  .next-date {
    display: inline-block;
    margin-top: 14px;
    padding: 8px 14px;
    border-radius: var(--pill);
    background: var(--surface-2);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
