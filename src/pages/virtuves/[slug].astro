---
import Base from '../../layouts/Base.astro';
import TaxonomyHero from '../../components/TaxonomyHero.astro';
import RecipeBrowser from '../../components/RecipeBrowser.astro';
import { getCatalog, getCuisines, type Cuisine } from '../../lib/recipes';

export async function getStaticPaths() {
  const cuisines = await getCuisines();
  return cuisines.map((cuisine) => ({ params: { slug: cuisine.id }, props: { cuisine } }));
}

const { cuisine } = Astro.props as { cuisine: Cuisine };
const { recipes: all, cuisines, categories } = await getCatalog();
const recipes = all.filter((r) => r.data.cuisine.id === cuisine.id);
---

<Base title={`${cuisine.data.name} virtuve`} description={cuisine.data.description}>
  <TaxonomyHero
    name={`${cuisine.data.name} virtuve`}
    emoji={cuisine.data.emoji}
    color={cuisine.data.color}
    description={cuisine.data.description}
    count={recipes.length}
    parent={{ href: '/virtuves/', label: 'Virtuves' }}
  />
  <section class="container" style="padding-top:20px">
    {
      recipes.length ? (
        <RecipeBrowser recipes={recipes} cuisines={cuisines} categories={categories} cuisineFilter={false} />
      ) : (
        <div class="empty">
          <div class="big">{cuisine.data.emoji}</div>
          <h3>Receptes drīzumā</h3>
          <p>Šai virtuvei receptes vēl tiek gatavotas.</p>
        </div>
      )
    }
  </section>
</Base>
