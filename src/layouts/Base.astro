---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import LogoMark from '../components/LogoMark.astro';
import AdsLoader from '../components/AdsLoader.astro';
import { SITE } from '../site.config';
import { getCuisines, getCategories, getOccasions, getRecipes, cuisineUrl, categoryUrl, occasionUrl } from '../lib/recipes';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = SITE.description, image, type = 'website', noindex = false, jsonLd } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-image.png', Astro.site);
const path = Astro.url.pathname;

const [cuisines, categories, occasions, recipes] = await Promise.all([getCuisines(), getCategories(), getOccasions(), getRecipes()]);
const recipeIds = recipes.map((r) => r.id);

const is = {
  home: path === '/',
  recipes: path.startsWith('/receptes') || path.startsWith('/recepte/') || path.startsWith('/kategorijas'),
  cuisines: path.startsWith('/virtuves'),
  occasions: path.startsWith('/svetki'),
  fridge: path.startsWith('/ledusskapis'),
  tinder: path.startsWith('/tinderis'),
  favorites: path.startsWith('/izlase'),
};

const nav = [
  { href: '/receptes/', label: 'Receptes', on: is.recipes },
  { href: '/virtuves/', label: 'Virtuves', on: is.cuisines },
  { href: '/svetki/', label: 'Svētku galds', on: is.occasions },
  { href: '/ledusskapis/', label: 'Ledusskapis', on: is.fridge },
  { href: '/tinderis/', label: 'Tinderis', on: is.tinder },
];
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title || SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#faf6f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141110" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500..800;1,500..800&family=Inter:wght@400..700&family=Noto+Color+Emoji&display=swap"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Pāriet uz saturu</a>

    <header class="site-header" id="site-header">
      <div class="container">
        <a class="logo" href="/" aria-label={`${SITE.name}, sākumlapa`}>
          <span class="logo-mark"><LogoMark /></span>
          {SITE.name}
        </a>
        <nav class="main-nav" aria-label="Galvenā navigācija">
          {
            nav.map((t) => (
              <a href={t.href} aria-current={t.on ? 'page' : undefined}>
                {t.label}
              </a>
            ))
          }
        </nav>
        <div class="header-actions">
          <a class="header-search" href="/receptes/#meklet">
            <Icon name="search" />
            Meklēt receptes...
          </a>
          <a class="icon-btn header-search-mobile" href="/receptes/#meklet" aria-label="Meklēt receptes">
            <Icon name="search" />
          </a>
          <a class="icon-btn" href="/izlase/" aria-label="Mana izlase" aria-current={is.favorites ? 'page' : undefined}>
            <Icon name="heart" />
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="about">
            <a class="logo" href="/">
              <span class="logo-mark"><LogoMark /></span>
              {SITE.name}
            </a>
            <p class="footer-about">{SITE.description}</p>
            <ul class="footer-tools">
              <li><a href="/ledusskapis/">🧊 Kas ir ledusskapī?</a></li>
              <li><a href="/tinderis/">🔥 Recepšu Tinderis</a></li>
              <li><a href="/svetki/">🎉 Svētku galds un kalendārs</a></li>
            </ul>
          </div>
          <div>
            <h4>Virtuves</h4>
            <ul>
              {cuisines.map((c) => <li><a href={cuisineUrl(c.id)}>{c.data.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>Kategorijas</h4>
            <ul>
              {categories.map((c) => <li><a href={categoryUrl(c.id)}>{c.data.name}</a></li>)}
            </ul>
          </div>
          <div>
            <h4>Svētku galds</h4>
            <ul>
              {occasions.map((o) => <li><a href={occasionUrl(o.id)}>{o.data.name}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {SITE.name}. Gatavots ar mīlestību Latvijā.</span>
          <a href="/privatums/">Privātuma politika</a>
        </div>
      </div>
    </footer>

    <nav class="tabbar" aria-label="Apakšējā navigācija">
      <ul>
        <li>
          <a href="/" aria-current={is.home ? 'page' : undefined}>
            <span class="tab-icon"><Icon name="home" /></span>Sākums
          </a>
        </li>
        <li>
          <a href="/receptes/" aria-current={is.recipes || is.cuisines ? 'page' : undefined}>
            <span class="tab-icon"><Icon name="book" /></span>Receptes
          </a>
        </li>
        <li class="tab-center">
          <button type="button" data-ideas-open aria-haspopup="dialog" aria-current={is.fridge || is.tinder ? 'page' : undefined}>
            <span class="tab-fab"><Icon name="sparkle" /></span>Ko gatavot?
          </button>
        </li>
        <li>
          <a href="/svetki/" aria-current={is.occasions ? 'page' : undefined}>
            <span class="tab-icon"><Icon name="gift" /></span>Svētki
          </a>
        </li>
        <li>
          <a href="/izlase/" aria-current={is.favorites ? 'page' : undefined}>
            <span class="tab-icon"><Icon name="heart" /></span>Izlase
          </a>
        </li>
      </ul>
    </nav>

    <!-- "Ko gatavot?" sheet -->
    <dialog class="sheet ideas" data-ideas aria-label="Ko gatavot?">
      <div class="sheet-grip" aria-hidden="true"></div>
      <h2>Ko šodien gatavot?</h2>
      <div class="ideas-grid">
        <a class="idea" href="/ledusskapis/" style="--c:#2f7f86">
          <span class="idea-emoji" aria-hidden="true">🧊</span>
          <strong>Kas ir ledusskapī?</strong>
          <span>Atzīmē produktus, un mēs atradīsim receptes</span>
        </a>
        <a class="idea" href="/tinderis/" style="--c:#c2334d">
          <span class="idea-emoji" aria-hidden="true">🔥</span>
          <strong>Recepšu Tinderis</strong>
          <span>Velc pa labi vai pa kreisi, līdz ir uzvarētājs</span>
        </a>
        <a class="idea" href="/svetki/" style="--c:#b8912a">
          <span class="idea-emoji" aria-hidden="true">🎉</span>
          <strong>Svētku galds</strong>
          <span>Receptes tuvākajiem svētkiem</span>
        </a>
        <a class="idea" href="/virtuves/" style="--c:#3b5b8c">
          <span class="idea-emoji" aria-hidden="true">🌍</span>
          <strong>Pasaules virtuves</strong>
          <span>No Latvijas līdz Meksikai</span>
        </a>
      </div>
      <button type="button" class="btn btn-ghost ideas-random" data-random>
        <Icon name="dice" /> Pārsteidz mani ar nejaušu recepti
      </button>
      <button type="button" class="icon-btn sheet-close" data-ideas-close aria-label="Aizvērt"><Icon name="x" /></button>
    </dialog>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script is:inline type="application/json" id="recipe-ids" set:html={JSON.stringify(recipeIds)} />

    <script>
      import { initFavorites } from '../lib/favorites';
      import { initTimers } from '../lib/timers';

      initFavorites();
      initTimers();

      // Toasts must follow the timers into an open modal, otherwise the top layer hides them.
      const toastEl = document.getElementById('toast')!;
      document.addEventListener('timers:host', (e) => ((e as CustomEvent<HTMLElement | null>).detail ?? document.body).appendChild(toastEl));

      const header = document.getElementById('site-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // "Ko gatavot?" sheet
      const sheet = document.querySelector<HTMLDialogElement>('[data-ideas]')!;
      document.querySelector('[data-ideas-open]')?.addEventListener('click', () => sheet.showModal());
      sheet.querySelector('[data-ideas-close]')!.addEventListener('click', () => sheet.close());
      sheet.addEventListener('click', (e) => e.target === sheet && sheet.close());

      document.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('[data-random]')) return;
        const ids: string[] = JSON.parse(document.getElementById('recipe-ids')!.textContent || '[]');
        if (ids.length) location.href = `/recepte/${ids[Math.floor(Math.random() * ids.length)]}/`;
      });
    </script>
    <AdsLoader />
  </body>
</html>

<style>
  .footer-about {
    margin-top: 12px;
    max-width: 40ch;
  }
  .footer-tools {
    margin-top: 16px;
  }
</style>
