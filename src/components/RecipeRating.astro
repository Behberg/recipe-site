---
import type { Rating } from '../lib/ratings';
import { decimal } from '../lib/format';
import { count, t, type Lang } from '../i18n';

/** 1 to 5 star rating for a recipe. Votes go to /api/ratings (netlify/functions/ratings.mts). */
interface Props {
  id: string;
  lang: Lang;
  rating: Rating | null;
}
const { id, lang, rating } = Astro.props;
const summary = rating
  ? `${t(lang, 'rating.summary', { avg: decimal(rating.value, lang) })} · ${count(lang, rating.count, 'count.ratings')}`
  : t(lang, 'rating.none');
const STAR = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z';
---

<section class="rating no-print" id="vertejums" data-rating={id} aria-labelledby="rating-title">
  <h2 id="rating-title">{t(lang, 'rating.title')}</h2>
  <div class="stars" role="radiogroup" aria-labelledby="rating-title" data-stars>
    {
      [1, 2, 3, 4, 5].map((n) => (
        <button type="button" role="radio" aria-checked="false" data-star={n} aria-label={t(lang, 'rating.star', { n })} class:list={{ on: rating && n <= Math.round(rating.value) }}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={STAR} /></svg>
        </button>
      ))
    }
  </div>
  <p class="summary" data-rating-summary aria-live="polite">{summary}</p>
</section>

<script>
  import { ct, ccount, pageLang } from '../i18n/client';
  import { decimal } from '../lib/format';

  const box = document.querySelector<HTMLElement>('[data-rating]');
  if (box) {
    const id = box.dataset.rating!;
    const lang = pageLang();
    const stars = Array.from(box.querySelectorAll<HTMLButtonElement>('[data-star]'));
    const out = box.querySelector<HTMLElement>('[data-rating-summary]')!;
    const KEY = `dz-rating-${id}`;
    let mine = 0;
    try {
      mine = Number(localStorage.getItem(KEY)) || 0;
    } catch {}

    const paint = (value: number) => stars.forEach((b, i) => b.classList.toggle('on', i < value));
    const show = (agg?: [number, number]) => {
      if (!agg || agg[0] < 1) return;
      const avg = Math.round((agg[1] / agg[0]) * 10) / 10;
      out.textContent = `${ct('rating.summary', { avg: decimal(avg, lang) })} · ${ccount(agg[0], 'count.ratings')}`;
      if (!mine) paint(Math.round(avg));
    };
    const select = (n: number) => {
      mine = n;
      paint(n);
      stars.forEach((b, i) => b.setAttribute('aria-checked', String(i + 1 === n)));
    };
    if (mine) select(mine);

    fetch(`/api/ratings?id=${encodeURIComponent(id)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => j && show(j[id]))
      .catch(() => {});

    box.querySelector('[data-stars]')!.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-star]');
      if (!btn) return;
      const n = Number(btn.dataset.star);
      const before = mine;
      select(n);
      try {
        const res = await fetch('/api/ratings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id, stars: n }) });
        if (!res.ok) throw new Error(String(res.status));
        const j = await res.json();
        show(j[id]);
        out.textContent += ` · ${ct('rating.thanks')}`;
        try {
          localStorage.setItem(KEY, String(n));
        } catch {}
      } catch {
        select(before);
        out.textContent = ct('rating.error');
      }
    });
  }
</script>

<style>
  .rating {
    margin-top: 28px;
    padding: 18px 20px;
    border-radius: var(--r);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  h2 {
    font-size: 1.1rem;
    margin: 0 0 8px;
  }
  .stars {
    display: flex;
    gap: 4px;
  }
  .stars button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 50%;
  }
  .stars svg {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.5;
    stroke-linejoin: round;
    transition: transform 0.15s;
  }
  .stars button.on svg {
    fill: var(--honey);
    stroke: var(--honey);
  }
  .stars:hover button svg {
    fill: var(--honey);
    stroke: var(--honey);
  }
  .stars button:hover ~ button svg {
    fill: none;
    stroke: var(--ink-3);
  }
  .stars button:hover svg {
    transform: scale(1.12);
  }
  .stars button:focus-visible {
    outline: 2px solid var(--brand);
  }
  .summary {
    margin: 6px 0 0;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
</style>
