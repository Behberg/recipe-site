---
import Base from '../layouts/Base.astro';
import { langFromPath, href, t } from '../i18n';

/** The 404 page, shared by /404.html and /en/404/, /ru/404/, /lt/404/ (see netlify.toml). */
const lang = langFromPath(Astro.url.pathname);
---

<Base title={t(lang, 'nf.title')} noindex>
  <section class="container notfound">
    <div class="big" aria-hidden="true">🍳</div>
    <h1>{t(lang, 'nf.h1')}</h1>
    <p>{t(lang, 'nf.text')}</p>
    <div class="actions">
      <a class="btn btn-primary" href={href(lang, '/')}>{t(lang, 'nf.home')}</a>
      <a class="btn btn-ghost" href={href(lang, '/receptes/')}>{t(lang, 'nf.all')}</a>
    </div>
  </section>
</Base>

<style>
  .notfound {
    text-align: center;
    padding-block: 72px 40px;
  }
  .big {
    font-size: 5rem;
    line-height: 1;
  }
  h1 {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    margin-top: 16px;
  }
  p {
    color: var(--ink-2);
    margin: 12px auto 0;
    max-width: 44ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 24px;
  }
</style>
