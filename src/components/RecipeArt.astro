---
import { imageUrl, imageSrcset } from '../lib/recipes';

/** Recipe photo, or an illustrated emoji fallback when the admin has not uploaded one yet. */
interface Props {
  image?: string;
  emoji: string;
  color: string;
  alt: string;
  sizes?: string;
  large?: boolean;
  eager?: boolean;
}

const { image, emoji, color, alt, sizes = '(min-width: 1100px) 280px, (min-width: 700px) 33vw, 50vw', large = false, eager = false } = Astro.props;
const srcset = image ? imageSrcset(image) : '';
---

{
  image ? (
    <img
      src={imageUrl(image, large ? 1400 : 700)}
      srcset={srcset || undefined}
      sizes={srcset ? sizes : undefined}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class:list={['art', { 'art--lg': large }]} style={`--c:${color}`} role="img" aria-label={alt}>
      <span class="art-emoji" aria-hidden="true">
        {emoji}
      </span>
    </div>
  )
}
