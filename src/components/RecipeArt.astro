---
import { imageUrl, imageSrcset } from '../lib/recipes';
import { dishIconSvg, parseIcon } from '../lib/dishIcons';

/**
 * Recipe photo if the admin uploaded one. Otherwise an illustrated dish icon (see
 * src/lib/dishIcons.ts), and as the last fallback the recipe's emoji.
 */
interface Props {
  image?: string;
  emoji: string;
  icon?: string;
  iconColors?: string;
  iconExtra?: string;
  color: string;
  alt: string;
  sizes?: string;
  large?: boolean;
  eager?: boolean;
}

const {
  image,
  emoji,
  icon,
  iconColors,
  iconExtra,
  color,
  alt,
  sizes = '(min-width: 1100px) 280px, (min-width: 700px) 33vw, 50vw',
  large = false,
  eager = false,
} = Astro.props;
const srcset = image ? imageSrcset(image) : '';
const svg = image ? '' : dishIconSvg(parseIcon(icon, iconColors, iconExtra), alt);
---

{
  image ? (
    <img
      src={imageUrl(image, large ? 1400 : 700)}
      srcset={srcset || undefined}
      sizes={srcset ? sizes : undefined}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  ) : svg ? (
    <div class:list={['art', 'art--icon', { 'art--lg': large }]} style={`--c:${color}`} set:html={svg} />
  ) : (
    <div class:list={['art', { 'art--lg': large }]} style={`--c:${color}`} role="img" aria-label={alt}>
      <span class="art-emoji" aria-hidden="true">
        {emoji}
      </span>
    </div>
  )
}
