---
import { quizUrl, type Quiz } from '../lib/quizzes';
import { langFromPath, t } from '../i18n';

interface Props {
  quiz: Quiz;
}

const { quiz } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
---

<a class="quiz-card" href={quizUrl(quiz.id, lang)} style={`--qc:${quiz.color}`}>
  <span class="qc-art" aria-hidden="true">
    <span class="qc-main">{quiz.emoji}</span>
    <span class="qc-results">{quiz.results.map((r) => <span>{r.emoji}</span>)}</span>
  </span>
  <span class="qc-body">
    <span class="qc-title">{quiz.title}</span>
    <span class="qc-hook">{quiz.hook}</span>
    <span class="qc-meta">{t(lang, 'quiz.meta', { n: quiz.questions.length })}</span>
  </span>
</a>

<style>
  .quiz-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--line);
    transition:
      transform 0.2s var(--ease),
      box-shadow 0.2s;
  }
  .quiz-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .qc-art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 0.7), transparent 60%),
      linear-gradient(135deg, color-mix(in oklab, var(--qc) 14%, var(--bg)), color-mix(in oklab, var(--qc) 34%, var(--bg)));
  }
  .qc-main {
    font-size: clamp(3rem, 2rem + 4vw, 4.2rem);
    filter: drop-shadow(0 8px 12px rgb(40 25 10 / 0.18));
    transition: transform 0.3s var(--ease);
  }
  .quiz-card:hover .qc-main {
    transform: scale(1.08) rotate(-4deg);
  }
  .qc-results {
    position: absolute;
    inset: auto 10px 10px 10px;
    display: flex;
    justify-content: center;
    gap: 4px;
    font-size: 1rem;
  }
  .qc-results span {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--pill);
    background: rgb(255 255 255 / 0.85);
    box-shadow: var(--shadow-sm);
  }
  .qc-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 16px;
  }
  .qc-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.2;
    color: var(--ink);
  }
  .qc-hook {
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .qc-meta {
    margin-top: 2px;
    font-size: 0.78rem;
    font-weight: 600;
    color: color-mix(in oklab, var(--qc) 80%, var(--ink));
  }
  @media (prefers-color-scheme: dark) {
    .qc-results span {
      background: rgb(30 26 24 / 0.85);
    }
    .qc-meta {
      color: color-mix(in oklab, var(--qc) 55%, var(--ink));
    }
  }
</style>
