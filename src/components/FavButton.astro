---
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  class?: string;
}
const { id, title, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['fav-btn', className]}
  data-fav={id}
  aria-pressed="false"
  aria-label={`Saglabāt izlasē: ${title}`}
>
  <Icon name="heart" />
</button>
