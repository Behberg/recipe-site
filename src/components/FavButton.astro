---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props {
  id: string;
  title: string;
  class?: string;
  lang: Lang;
}
const { id, title, class: className, lang } = Astro.props;
---

<button
  type="button"
  class:list={['fav-btn', className]}
  data-fav={id}
  aria-pressed="false"
  aria-label={t(lang, 'card.save', { title })}
>
  <Icon name="heart" />
</button>
