---
import { ADS, adsEnabled, adSlotId } from '../site.config';
import { langFromPath, t } from '../i18n';

/**
 * A single Google AdSense unit.
 *
 * Design rules so ads earn well without annoying readers or breaking AdSense policy:
 * - always clearly labelled "Reklāma" and visually separated from the content,
 * - space is reserved up front, so the page never jumps when an ad loads (good for viewability
 *   and for Core Web Vitals),
 * - on phones the unit may grow to the full screen width (data-full-width-responsive),
 * - units are filled only when they are about to scroll into view,
 * - nothing inside the cooking mode, dialogs or right next to buttons.
 *
 * A placement without its own ID in src/site.config.ts uses ADS.fallbackSlot. When neither is set
 * nothing is rendered (in dev a placeholder shows where ads go).
 */
interface Props {
  slot: keyof typeof ADS.slots;
  class?: string;
}

const { slot, class: className } = Astro.props;
const label = t(langFromPath(Astro.url.pathname), 'common.ad');
const id = adsEnabled() ? adSlotId(slot) : '';
const showPlaceholder = !id && import.meta.env.DEV;
---

{
  id ? (
    <aside class:list={['ad', className]} aria-label={label} data-ad-place={slot}>
      <span class="ad-label">{label}</span>
      <ins
        class="adsbygoogle ad-slot"
        data-ad-client={ADS.client}
        data-ad-slot={id}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    </aside>
  ) : showPlaceholder ? (
    <aside class:list={['ad', className]} aria-hidden="true" data-ad-place={slot}>
      <span class="ad-label">{label}</span>
      <div class="ad-placeholder">Reklāmas vieta ({slot}), redzama tikai izstrādes režīmā</div>
    </aside>
  ) : null
}
