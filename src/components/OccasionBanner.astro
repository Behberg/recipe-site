---
import Icon from './Icon.astro';
import RecipeCard from './RecipeCard.astro';
import { getCatalog, getOccasions, occasionUrl, plural } from '../lib/recipes';

/**
 * Seasonal suggestion driven by the built-in calendar. The static build does not know
 * today's date, so every dated occasion is pre-rendered in a <template> and the browser
 * picks the one that is coming up.
 *
 * mode="home": full banner only while an occasion is within its leadDays window,
 *              otherwise a small "next occasion" teaser.
 * mode="page": always the full banner for the nearest dated occasion.
 */
interface Props {
  mode?: 'home' | 'page';
}
const { mode = 'home' } = Astro.props;

const [occasions, { recipes, cuisineById, categoryById }] = await Promise.all([getOccasions(), getCatalog()]);
const dated = occasions.filter((o) => o.data.dateType !== 'nav');
const rules = dated.map((o) => ({ id: o.id, ...o.data }));
---

<section class="occ-banner container" data-occ-banner data-mode={mode} hidden>
  {
    dated.map((o) => {
      const list = recipes.filter((r) => r.data.occasions.some((x) => x.id === o.id)).slice(0, 8);
      return (
        <template data-occ={o.id}>
          <div class="occ-hero" style={`--c:${o.data.color}`}>
            <div class="occ-copy">
              <span class="occ-when">
                <Icon name="calendar" />
                <span data-when />
              </span>
              <h2>
                {o.data.name} <span aria-hidden="true">{o.data.emoji}</span>
              </h2>
              <p>{o.data.description}</p>
              <a class="btn occ-btn" href={occasionUrl(o.id)}>
                Visas svētku receptes <Icon name="arrow-right" />
              </a>
            </div>
            <span class="occ-emoji" aria-hidden="true">
              {o.data.emoji}
            </span>
          </div>
          {list.length > 0 && (
            <div class="rail occ-rail">
              {list.map((r) => (
                <RecipeCard recipe={r} cuisine={cuisineById.get(r.data.cuisine.id)} category={categoryById.get(r.data.category.id)} wide />
              ))}
            </div>
          )}
        </template>
      );
    })
  }
  {
    dated.map((o) => {
      const n = recipes.filter((r) => r.data.occasions.some((x) => x.id === o.id)).length;
      return (
        <template data-occ-teaser={o.id}>
          <a class="occ-teaser" href={occasionUrl(o.id)} style={`--c:${o.data.color}`}>
            <span class="occ-teaser-emoji" aria-hidden="true">
              {o.data.emoji}
            </span>
            <span class="occ-teaser-text">
              <small>Nākamie svētki</small>
              <strong>{o.data.name}</strong>
              <span data-when />
            </span>
            <span class="occ-teaser-count">
              {n} {plural(n, 'recepte', 'receptes')} <Icon name="arrow-right" />
            </span>
          </a>
        </template>
      );
    })
  }
  <div data-occ-slot></div>
</section>

<script is:inline type="application/json" data-occ-rules set:html={JSON.stringify(rules)} />

<script>
  import { nextOccurrence, formatDateLong, countdown, type OccasionRule } from '../lib/calendar';
  import { syncFavorites } from '../lib/favorites';

  document.querySelectorAll<HTMLElement>('[data-occ-banner]').forEach((root) => {
    const rules: OccasionRule[] = JSON.parse(root.nextElementSibling!.textContent || '[]');
    const upcoming = rules
      .map((r) => ({ r, next: nextOccurrence(r) }))
      .filter((x) => x.next)
      .sort((a, b) => a.next!.days - b.next!.days);
    if (!upcoming.length) return;

    const inWindow = upcoming.find((x) => x.next!.days <= x.r.leadDays);
    const full = root.dataset.mode === 'page' ? upcoming[0] : inWindow;
    const pick = full ?? upcoming[0];
    const tpl = root.querySelector<HTMLTemplateElement>(full ? `[data-occ="${pick.r.id}"]` : `[data-occ-teaser="${pick.r.id}"]`);
    if (!tpl) return;

    const frag = tpl.content.cloneNode(true) as DocumentFragment;
    const when = `${formatDateLong(pick.next!.date)}, ${countdown(pick.next!.days)}`;
    frag.querySelectorAll('[data-when]').forEach((el) => (el.textContent = when));
    root.querySelector('[data-occ-slot]')!.replaceChildren(frag);
    root.hidden = false;
    syncFavorites();
  });
</script>

<style>
  .occ-banner {
    padding-top: 12px;
    padding-bottom: 8px;
  }
  .occ-hero {
    --c: var(--brand);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 22px 20px 24px;
    border-radius: var(--r-lg);
    color: #fff;
    background:
      radial-gradient(circle at 100% 0%, rgb(255 255 255 / 0.22), transparent 55%),
      linear-gradient(150deg, color-mix(in oklab, var(--c) 85%, #fff 15%), color-mix(in oklab, var(--c) 85%, #000 15%));
    box-shadow: 0 20px 40px -24px var(--c);
  }
  @media (min-width: 768px) {
    .occ-hero {
      padding: 36px 40px;
    }
  }
  .occ-copy {
    max-width: min(32rem, 74%);
  }
  .occ-when {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--pill);
    background: rgb(255 255 255 / 0.2);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .occ-when :global(svg) {
    width: 16px;
    height: 16px;
  }
  .occ-hero h2 {
    color: #fff;
    font-size: clamp(1.8rem, 1.3rem + 2.4vw, 2.8rem);
    margin-top: 10px;
  }
  .occ-hero p {
    margin-top: 8px;
    opacity: 0.92;
    font-size: 0.95rem;
  }
  .occ-btn {
    margin-top: 16px;
    background: #fff;
    color: #1d1916;
    min-height: 44px;
  }
  .occ-emoji {
    position: absolute;
    right: -14px;
    bottom: -20px;
    font-size: clamp(6.5rem, 28vw, 11rem);
    line-height: 1;
    transform: rotate(-12deg);
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.3));
    z-index: -1;
  }
  .occ-rail {
    margin-top: 16px;
  }
  .occ-teaser {
    --c: var(--brand);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px 12px 12px;
    border-radius: var(--r);
    background: color-mix(in oklab, var(--c) 10%, var(--surface));
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c) 22%, transparent);
    transition: transform 0.2s var(--ease);
  }
  .occ-teaser:hover {
    transform: translateY(-2px);
  }
  .occ-teaser-emoji {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 16px;
    background: var(--c);
    font-size: 1.7rem;
  }
  .occ-teaser-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.25;
  }
  .occ-teaser-text small {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c);
  }
  .occ-teaser-text strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }
  .occ-teaser-text span {
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .occ-teaser-count {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c);
  }
  .occ-teaser-count :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
